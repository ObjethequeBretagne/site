---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/png" href="/assets/img/illuPresa2.png" />
    <title>{title} · Admin Objethèque</title>
  </head>
  <body>
    <header>
      <a href="/admin">Admin Objethèque</a>
      <a href="/" target="_blank">Voir le site</a>
    </header>
    <main>
      <p id="deploiement" class="message" hidden></p>
      <h1>{title}</h1>
      <slot />
    </main>
  </body>
</html>

<script>
  // Listes éditables : chaque <li class="ligne"> est une entrée, dans l'ordre du
  // formulaire. Ajouter clone le <template> de la liste, les boutons déplacent ou
  // retirent la ligne. Rien n'est enregistré avant l'envoi du formulaire.
  document.addEventListener("click", (e) => {
    const bouton = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-action]");
    if (!bouton) return;

    if (bouton.dataset.action === "ajouter") {
      const liste = document.getElementById(bouton.dataset.liste!)!;
      const modele = document.getElementById(`${bouton.dataset.liste}-modele`) as HTMLTemplateElement;
      liste.append(modele.content.cloneNode(true));
      liste.lastElementChild?.querySelector("input")?.focus();
      return;
    }

    const ligne = bouton.closest("li")!;
    if (bouton.dataset.action === "monter") ligne.previousElementSibling?.before(ligne);
    if (bouton.dataset.action === "descendre") ligne.nextElementSibling?.after(ligne);
    if (bouton.dataset.action === "retirer" && confirm("Retirer cette entrée ?")) ligne.remove();
  });

  // Enregistrer : l'envoi et le commit prennent quelques secondes. L'événement submit
  // n'arrive qu'une fois les champs obligatoires remplis, donc le bouton ne se bloque
  // jamais sur un formulaire refusé par le navigateur.
  document.addEventListener("submit", (e) => {
    const bouton = (e.target as HTMLFormElement).querySelector<HTMLButtonElement>("button[type=submit]");
    if (!bouton) return;
    bouton.disabled = true;
    bouton.textContent = "Enregistrement…";
  });
  // Retour arrière vers une page gardée en cache : le bouton doit être utilisable.
  addEventListener("pageshow", (e) => {
    if (!e.persisted) return;
    for (const bouton of document.querySelectorAll<HTMLButtonElement>("button[type=submit]")) {
      bouton.disabled = false;
      bouton.textContent = "Enregistrer";
    }
  });

  // Images : converties en WebP dans le navigateur dès qu'on les choisit, le Worker
  // ne sachant pas le faire. data-webp donne la plus grande dimension en pixels.
  // Les SVG restent tels quels ; si le navigateur n'exporte pas en WebP, on garde
  // le fichier d'origine.
  document.addEventListener("change", async (e) => {
    const champ = e.target as HTMLInputElement;
    const fichier = champ.files?.[0];
    if (!champ.dataset.webp || !fichier || fichier.type === "image/svg+xml") return;

    const image = await createImageBitmap(fichier).catch(() => null);
    if (!image) return;
    const echelle = Math.min(1, Number(champ.dataset.webp) / Math.max(image.width, image.height));
    const canvas = document.createElement("canvas");
    canvas.width = Math.round(image.width * echelle);
    canvas.height = Math.round(image.height * echelle);
    canvas.getContext("2d")!.drawImage(image, 0, 0, canvas.width, canvas.height);

    const blob = await new Promise<Blob | null>((ok) => canvas.toBlob(ok, "image/webp", 0.85));
    if (blob?.type !== "image/webp") return;
    const nom = fichier.name.replace(/\.[^.]*$/, "") + ".webp";
    const transfert = new DataTransfer();
    transfert.items.add(new File([blob], nom, { type: "image/webp" }));
    champ.files = transfert.files;
  });

  // Mise en ligne : chaque enregistrement relance le build, et le site (cette page
  // comprise) sert l'ancienne version en attendant. Vérifié toutes les 15 s pendant
  // un déploiement, toutes les 60 s sinon, jamais quand l'onglet est caché.
  const bandeau = document.getElementById("deploiement")!;
  let enCours = false;
  let termine = false; // reste affiché jusqu'au rechargement ou au déploiement suivant
  let verifieA = 0;

  async function verifier() {
    verifieA = Date.now();
    const etat = await fetch("/admin/deploiement.json").then((r) => r.json()).catch(() => null);
    if (!etat?.ok) return; // GitHub injoignable : on garde le dernier état connu
    if (enCours && !etat.enCours) termine = true;
    if (etat.enCours) termine = false;
    enCours = etat.enCours;

    const heure = new Date(etat.date).toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit" });
    bandeau.hidden = !enCours && !termine;
    bandeau.className = `message ${termine ? "ok" : etat.echec ? "erreur" : "attente"}`;
    if (termine) {
      bandeau.innerHTML = `<strong>Mise en ligne terminée.</strong> <button type="button" onclick="location.reload()">Actualiser</button>`;
    } else if (etat.echec) {
      bandeau.textContent = `Mise en ligne échouée : l'enregistrement de ${heure} n'est toujours pas en ligne après 10 minutes. Regarde le build sur Cloudflare.`;
    } else if (enCours) {
      bandeau.textContent = `Mise en ligne en cours depuis ${heure} (« ${etat.message} »). Le site et l'admin montrent encore l'ancienne version. Dans environ 1mn30s, ce bandeau devient vert quand c'est en ligne.`;
    }
  }

  function tic() {
    if (document.visibilityState !== "visible") return;
    if (!enCours && Date.now() - verifieA < 60_000) return;
    verifier();
  }
  setInterval(tic, 15_000);
  document.addEventListener("visibilitychange", tic);
  verifier();
</script>

<style is:global>
  :root {
    --teal: #108a9d;
    --orange: #ff9900;
    --fond: #fffefe;
    --carte: #f1f1f1;
    --texte: #1d2b2b;
    --discret: #616161;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --fond: #1c1227;
      --carte: #2a1f44;
      --texte: #ececec;
      --discret: #afafaf;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    background: var(--fond);
    color: var(--texte);
  }
  header {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: var(--teal);
  }
  header a {
    color: #fff;
    font-weight: 600;
  }
  main {
    max-width: 60rem;
    margin: 0 auto;
    padding: 1rem;
  }
  .message {
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
  }
  .message.ok {
    background: #d7f2e3;
    color: #145c36;
  }
  .message.attente {
    background: #fdeccc;
    color: #6b4300;
  }
  .message.erreur {
    background: #fbdada;
    color: #7a1616;
  }
  ol.liste {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .ligne {
    display: grid;
    gap: 0.5rem;
    padding: 0.75rem;
    border-radius: 0.5rem;
    background: var(--carte);
  }
  .ligne label {
    display: grid;
    gap: 0.25rem;
    font-size: 0.85rem;
    color: var(--discret);
  }
  .ligne input,
  .ligne select {
    font: inherit;
    padding: 0.4rem;
    color: var(--texte);
    background: var(--fond);
    border: 1px solid var(--discret);
    border-radius: 0.3rem;
  }
  .ligne input:disabled {
    opacity: 0.5;
  }
  .ligne .boutons {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
  }
  button {
    font: inherit;
    cursor: pointer;
    padding: 0.4rem 0.8rem;
    border-radius: 0.3rem;
    border: 1px solid var(--teal);
    background: transparent;
    color: inherit;
  }
  button[type="submit"]:disabled {
    cursor: wait;
    opacity: 0.7;
  }
  button[type="submit"] {
    background: var(--orange);
    border-color: var(--orange);
    color: #000;
    font-weight: 600;
  }
  .actions {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    position: sticky;
    bottom: 0;
    padding-block: 0.75rem;
    background: var(--fond);
  }
</style>
