---
interface Props {
  title: string;
}

const { title } = Astro.props;
import Header from "../layouts/header.astro";
import Footer from "../layouts/footer.astro";
import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Bibliothèque d'objets à Quimper" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href="/menuscript.js" as="script" />
    <link rel="icon" type="image/png" href="assets/img/illuPresa2.png" />
    <link type="text/css" rel="stylesheet" href="objetheque.css" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
    ></script>
    <script defer src="/menuscript.js"></script>
   <ClientRouter />
  </head>
  <body>
    <Header transition:persist/>
    <slot />
    <Footer transition:persist/>
  </body>
</html>
