---
interface Props {
  title: string;
}

const { title } = Astro.props;
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import { ViewTransitions } from "astro:transitions";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Bibliothèque d'objets à Quimper" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href="/menuscript.js" as="script" />
    <link rel="icon" type="image/png" href="assets/img/illuPresa2.png" />
    <link rel="preload" as="image" href="/assets/img/boisClairHorizontal.jpg">
    <link rel="preload" as="image" href="/assets/img/illuPresa.png">
    <link rel="preload" href="assets/polices/Ebrima/ebrima.ttf" as="font" type="font/ttf" crossorigin="anonymous">
    <link rel="preload" href="assets/polices/Ebrima/ebrima-bold.ttf" as="font" type="font/ttf" crossorigin="anonymous">
    <link type="text/css" rel="stylesheet" href="objetheque.css" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script defer src="/menuscript.js"></script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    
  </body>
</html>
