  <div id="widgetReseaux">
    <a
      href="https://www.facebook.com/ObjethequeCornouaille"
      target="_blank"
      class="scaleUpHover"
      ><img
        class="widgetReseau"
        alt="icône/lien vers la page Facebook"
        src="/assets/svg/Facebook_icon.svg"
      /></a
    >
    <a
      href="https://www.instagram.com/objetheque_cornouaille/"
      target="_blank"
      class="scaleUpHover"
      ><img
        class="widgetReseau"
        alt="icône/lien vers l'instagram de l'association"
        src="/assets/svg/instagram-social-media.svg"
      /></a
    >
    <a
      href="https://fr.linkedin.com/company/l-objeth%C3%A8que-de-cornouaille"
      target="_blank"
      class="scaleUpHover"
      ><img
        class="widgetReseau"
        alt="icône/lien vers la page linkedin"
