      <Picture
        src={logo}
        formats={["avif", "webp"]}
        alt="logo de l'objetheque de Cornouaille"
        id="logo-site"
        loading="eager"
        fetchpriority="high"
        transition:persist
      />
    </a>
  </div>
  <!--DEBUT Menu pour le format écran ordinateur-->
  <nav class="navWeb">
    <ul id="menuWeb">
      <li>
        <a href="/apropos/">à propos</a>
