          <li>
            <a href="/apropos/#H200">Nos valeurs</a>
          </li>
          <li>
            <a href="/apropos/#H201">Notre équipe</a>
          </li>
          <li>
            <a href="/apropos/#H202">Nos partenaires</a>
          </li>
          <li>
            <a href="/apropos/#H203">Les medias en parlent</a>
          </li>
          <li>
            <a href="/apropos/#H205">Documents utiles</a>
          </li>
          <li>
            <a
              href="https://umap.openstreetmap.fr/fr/map/bibliotheques-dobjets-et-objetheques-france_832483"
              target="_blank">Réseau</a
