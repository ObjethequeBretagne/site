  </nav>
  <div id="boutonsOranges">
    <nav class="boutonOrange scaleUpHover">
      <a
        href="https://objethequecornouaille.myturn.com/library/myTurnLogin/auth"
        target="_blank"
        ><p>
          Mon compte<svg class="iconeBouton" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="5"/>
            <path d="M20 21a8 8 0 0 0-16 0"/>
          </svg>
        </p></a
      >
    </nav>
    <nav id="boutonCatalogue" class="boutonOrange scaleUpHover">
      <a
        href="https://objethequecornouaille.myturn.com/library/inventory/browse"
        target="_blank"
        ><p>
          Catalogue<svg class="iconeBouton" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="white">
            <path d="M7 17h7v-2H7v2zm0-4h10v-2H7v2zm0-4h10V7H7v2zM5 21q-.825 0-1.412-.587T3 19V5q0-.825.588-1.412T5 3h14q.825 0 1.413.588T21 5v14q0 .825-.587 1.413T19 21H5zm0-2h14V5H5v14zM5 5v14V5z"/>
          </svg>
        </p></a
      >
    </nav>
