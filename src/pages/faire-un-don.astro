---
import Layout from "../layouts/layout.astro";
---

<Layout title="Faire un don">
  <main>
    <h2 class="h2PaddingTopBig">Faire un don financier</h2>
    <section id="faireUnDon">
      <p>
        Pour faire fonctionner le système de prêt d’objets, tous les dons aident !
        <br /><br />
        Vous pouvez nous soutenir en faisant un don sur <a
          class="soulignementOrange"
          target="_blank"
          href="https://www.helloasso.com/associations/l-objetheque-de-cornouaille/formulaires/1"
          ><strong>Hello Asso</strong>&nbsp;
          <img
            style="height: 40px; margin-top: 0.8rem;"
            src="/assets/svg/logo-helloasso.svg"
            alt="logo helloasso"
          /></a
        >
        ou par <a style="white-space: nowrap;" class="soulignementOrange2" href="iban-bic.pdf">
          <strong>virement bancaire</strong>&nbsp;
          <img
            style="height: 40px; margin-top: 0.8rem;"
            src="/assets/img/pdf-logo.png"
            alt="logo pdf"
          />
        </a>
        <br /><br />
        Les dons ouvrent droit à une réduction d'impôt sur le revenu égale à 66 % du montant versé, dans la limite de 20 % du revenu imposable. 
        <br/>
        Par exemple, un don de 50 euros ouvre droit à une réduction d'impôt de 33 euros, un don de 100 euros à une réduction de 66 euros, etc.
      </p>
      <div id="haWidgetContainer">
        <iframe
          id="haWidget"
          title="Formulaire de don HelloAsso"
          allowtransparency="true"
          scrolling="auto"
          src="https://www.helloasso.com/associations/l-objetheque-de-cornouaille/formulaires/1/widget"
        ></iframe>
      </div>
    </section>
  </main>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const haWidget = document.getElementById("haWidget") as HTMLIFrameElement | null;
    if (!haWidget) return;

    window.addEventListener("message", (e) => {
      if (e.source !== haWidget.contentWindow) return;
      const dataHeight = e.data?.height;
      if (dataHeight > parseFloat(haWidget.style.height || "0")) {
        haWidget.style.height = dataHeight + "px";
      }
    });
  });
</script>

<style>
  #faireUnDon {
    margin-inline: clamp(5%, 2rem, 60%);
    padding-left: 1rem;
    color: var(--dark-text-color);
    margin-top: calc(var(--marginBlock) / 2);
    margin-bottom: calc(var(--marginBlock) / 2 + 150px);
  }

  #haWidgetContainer {
    margin-top: 2rem;
    padding-right: 1rem;
  }

  #haWidget {
    width: 100%;
    height: 750px;
    border: none;
    border-radius: 10px;
  }
</style>
 