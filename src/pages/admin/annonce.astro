---
export const prerender = false;
import AdminLayout from "../../layouts/admin.astro";
import BandeauAnnonce from "../../components/bandeau-annonce.astro";
import { commiter, jsonEnOctets, lireJson, listerDossier, nomLibre, type FichierACommiter } from "../../lib/github";

type Annonce = {
  afficher: boolean;
  icone: string;
  titre: string;
  texte: string;
  lienLibelle: string;
  lienHref: string;
};
const CHEMIN = "src/data/annonce.json";
const DOCUMENTS = "src/data/documents.json";
const DOSSIER_PDF = "/annonces/"; // seuls les PDF de ce dossier peuvent être supprimés
const TAILLE_MAX = 20 * 1024 * 1024;
// Suggestions d'icônes ; le champ accepte aussi n'importe quel autre emoji.
const EMOJIS: [string, string][] = [
  ["📢", "Annonce"], ["🔧", "Réparation"], ["🛠️", "Bricolage"], ["🧵", "Couture"],
  ["♻️", "Réemploi"], ["🌱", "Écologie"], ["📅", "Date"], ["🎉", "Fête"],
  ["🤝", "Bénévolat"], ["💼", "Recrutement"], ["🧸", "Enfants"], ["📦", "Collecte"],
  ["❤️", "Don"], ["⚠️", "Important"],
];

let erreur = "";

if (Astro.request.method === "POST") {
  try {
    const form = await Astro.request.formData();
    const actuel = await lireJson<Annonce>(CHEMIN);
    if (form.get("sha") !== actuel.sha) {
      throw new Error("Le bandeau a été modifié ailleurs entre-temps. Recharge la page et recommence.");
    }

    const champ = (nom: string) => String(form.get(nom) ?? "").trim();
    const bouton = champ("bouton"); // "aucun", "lien" ou "pdf"
    const annonce: Annonce = {
      afficher: form.has("afficher"),
      icone: champ("icone"),
      titre: champ("titre"),
      texte: champ("texte"),
      lienLibelle: bouton === "aucun" ? "" : champ("lienLibelle"),
      lienHref: "",
    };
    const fichiers: FichierACommiter[] = [];
    if (annonce.afficher && !annonce.titre) throw new Error("Le titre est obligatoire pour afficher le bandeau.");

    if (bouton === "lien") {
      annonce.lienHref = champ("lienHref");
      // Lien du site (/…) ou lien externe complet.
      if (!/^(https?:\/\/|\/)/.test(annonce.lienHref)) {
        throw new Error("Le lien doit commencer par https:// ou par / pour une page du site.");
      }
    } else if (bouton === "pdf") {
      // Le PDF d'annonce déjà en place, un document utile, ou un nouveau PDF d'annonce.
      const choix = champ("pdfChoix");
      if (choix === "nouveau") {
        const pdf = form.get("pdf") as File | null;
        if (!pdf?.size) throw new Error("Choisis le PDF à envoyer.");
        if (!pdf.name.toLowerCase().endsWith(".pdf")) throw new Error("Le fichier envoyé n'est pas un PDF.");
        if (pdf.size > TAILLE_MAX) throw new Error("Le PDF dépasse 20 Mo.");
        const pris = new Set(await listerDossier(`public${DOSSIER_PDF}`.slice(0, -1)));
        annonce.lienHref = `${DOSSIER_PDF}${nomLibre(annonce.titre || pdf.name, ".pdf", pris)}`;
        fichiers.push({ chemin: `public${annonce.lienHref}`, contenu: new Uint8Array(await pdf.arrayBuffer()) });
      } else {
        const { donnees: documents } = await lireJson<{ href: string }[]>(DOCUMENTS);
        const connu = (choix.startsWith(DOSSIER_PDF) && choix === actuel.donnees.lienHref) || documents.some((d) => d.href === choix);
        if (!connu) throw new Error("PDF inconnu : recharge la page et choisis-en un dans la liste.");
        annonce.lienHref = choix;
      }
    }
    if (annonce.lienHref && !annonce.lienLibelle) throw new Error("Le texte du bouton est obligatoire.");

    // L'ancien PDF d'annonce part quand le bouton ne pointe plus dessus.
    if (actuel.donnees.lienHref.startsWith(DOSSIER_PDF) && actuel.donnees.lienHref !== annonce.lienHref) {
      fichiers.push({ chemin: `public${actuel.donnees.lienHref}`, contenu: null });
    }

    fichiers.push({ chemin: CHEMIN, contenu: jsonEnOctets(annonce) });
    await commiter(fichiers, "Admin : bandeau d'annonce");
    return Astro.redirect("/admin/annonce");
  } catch (e) {
    erreur = `Pas enregistré : ${e instanceof Error ? e.message : String(e)}`;
  }
}

let annonce: Annonce | undefined;
let sha = "";
try {
  ({ donnees: annonce, sha } = await lireJson<Annonce>(CHEMIN));
} catch (e) {
  erreur ||= e instanceof Error ? e.message : String(e);
}
let documents: { title: string; href: string }[] = [];
try {
  ({ donnees: documents } = await lireJson<typeof documents>(DOCUMENTS));
} catch (e) {
  erreur ||= e instanceof Error ? e.message : String(e);
}
// PDF d'annonce envoyé par l'admin, ou document utile. Un lien externe en .pdf reste un lien.
const pdfAnnonce = annonce?.lienHref.startsWith(DOSSIER_PDF) ? annonce.lienHref : "";
const modePdf = !!pdfAnnonce || documents.some((d) => d.href === annonce?.lienHref);
---

<AdminLayout title="Bandeau d'annonce">
  {erreur && <p class="message erreur">{erreur}</p>}
  <p>Affiché sur l'accueil, sous la présentation. Rien n'est publié avant « Enregistrer ».</p>

  {annonce && (
    <form method="post" enctype="multipart/form-data">
      <input type="hidden" name="sha" value={sha} />
      <div class="ligne">
        <label class="case"><input type="checkbox" name="afficher" checked={annonce.afficher} /> Afficher le bandeau sur l'accueil</label>
        <label>Icône (un emoji, facultatif) <input name="icone" value={annonce.icone} /></label>
        <div class="emojis">
          {EMOJIS.map(([emoji, nom]) => <button type="button" data-emoji={emoji} title={nom} aria-label={nom}>{emoji}</button>)}
          <button type="button" data-emoji="" title="Sans icône">Aucune</button>
        </div>
        <label>Titre <input name="titre" value={annonce.titre} /></label>
        <label>Texte (facultatif) <input name="texte" value={annonce.texte} /></label>
        <fieldset>
          <legend>Bouton</legend>
          <label class="case"><input type="radio" name="bouton" value="aucun" checked={!annonce.lienHref} /> Pas de bouton</label>
          <label class="case"><input type="radio" name="bouton" value="lien" checked={!!annonce.lienHref && !modePdf} /> Lien</label>
          <label>Adresse <input name="lienHref" value={modePdf ? "" : annonce.lienHref} placeholder="https://… ou /page-du-site" pattern="(https?://|/).*" title="Commence par https:// ou par / pour une page du site" /></label>
          <label class="case"><input type="radio" name="bouton" value="pdf" checked={modePdf} /> PDF</label>
          <label>PDF
            <select name="pdfChoix">
              {pdfAnnonce && <option value={pdfAnnonce} selected>PDF d'annonce actuel ({pdfAnnonce.slice(DOSSIER_PDF.length)})</option>}
              <optgroup label="Documents utiles">
                {documents.map((d) => <option value={d.href} selected={d.href === annonce.lienHref}>{d.title}</option>)}
              </optgroup>
              <option value="nouveau" selected={!modePdf}>Envoyer un nouveau PDF d'annonce…</option>
            </select>
          </label>
          <label>Nouveau PDF d'annonce <input type="file" name="pdf" accept=".pdf,application/pdf" /></label>
          <label>Texte du bouton <input name="lienLibelle" value={annonce.lienLibelle} /></label>
        </fieldset>
      </div>
      <section class="apercu">
        <h2>Aperçu</h2>
        <p class="masque" hidden={annonce.afficher}>Masqué sur l'accueil : coche « Afficher le bandeau » pour le publier.</p>
        <BandeauAnnonce annonce={annonce} apercu />
      </section>
      <div class="actions">
        <span></span>
        <button type="submit">Enregistrer</button>
      </div>
    </form>
  )}
</AdminLayout>

<script>
  // Les champs obligatoires dépendent de ce qui est coché : on les marque `required`
  // pour que le navigateur bloque l'envoi et montre le champ, au lieu de laisser
  // partir le formulaire et d'afficher le refus du serveur après rechargement.
  const form = document.querySelector<HTMLFormElement>("form");
  if (form) {
    const champ = (nom: string) => form.elements.namedItem(nom) as HTMLInputElement;
    const majObligatoires = () => {
      const bouton = form.querySelector<HTMLInputElement>("[name=bouton]:checked")?.value;
      champ("titre").required = champ("afficher").checked;
      // Les champs d'un autre choix sont désactivés : ni vérifiés, ni envoyés.
      champ("lienHref").disabled = bouton !== "lien";
      champ("pdfChoix").disabled = bouton !== "pdf";
      champ("pdf").disabled = bouton !== "pdf" || champ("pdfChoix").value !== "nouveau";
      champ("lienLibelle").disabled = bouton === "aucun";
      champ("lienHref").required = true;
      champ("pdf").required = true;
      champ("lienLibelle").required = true;
    };
    form.addEventListener("change", majObligatoires);

    // Aperçu : reflète la saisie en direct, sans rien enregistrer.
    const apercu = (nom: string) => form.querySelector<HTMLElement>(`[data-apercu="${nom}"]`)!;
    const majApercu = () => {
      const bouton = form.querySelector<HTMLInputElement>("[name=bouton]:checked")?.value;
      const icone = champ("icone").value.trim();
      const texte = champ("texte").value.trim();
      apercu("icone").textContent = icone;
      apercu("icone").hidden = !icone;
      apercu("titre").textContent = champ("titre").value.trim() || "Titre du bandeau";
      apercu("texte").textContent = texte;
      apercu("texte").hidden = !texte;
      apercu("action").hidden = bouton === "aucun" || (bouton === "lien" && !champ("lienHref").value.trim());
      apercu("libelle").textContent = champ("lienLibelle").value.trim() || "Texte du bouton";
      apercu("pdf").hidden = bouton !== "pdf";
      form.querySelector<HTMLElement>(".masque")!.hidden = champ("afficher").checked;
    };
    form.addEventListener("input", majApercu);
    form.addEventListener("change", majApercu);
    // Dans l'aperçu, le bouton ne mène nulle part.
    apercu("action").addEventListener("click", (e) => e.preventDefault());

    form.addEventListener("click", (e) => {
      const emoji = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-emoji]");
      if (emoji) {
        champ("icone").value = emoji.dataset.emoji!;
        majApercu();
      }
    });
    majObligatoires();
  }
</script>

<style>
  /* Variables et styles de base du site, dont dépend le bandeau (global.css n'est
     pas chargé dans l'admin). */
  .apercu {
    --primary-color: #ff9900;
    --grey-background: rgba(231, 231, 231, 0.76);
    --dark-text-color: #095c5c;
    --light-text-color: #ffffff;
    margin-top: 1rem;
    padding: 0.75rem;
    border-radius: 0.5rem;
    background: #fffefe;
    color: var(--dark-text-color);
  }
  @media (prefers-color-scheme: dark) {
    .apercu {
      --grey-background: #2a1f44;
      --dark-text-color: #00caca;
      background: #1c1227;
    }
  }
  .apercu h2 {
    margin: 0;
    font-size: 0.85rem;
    color: var(--discret);
  }
  .apercu .masque {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--discret);
  }
  .apercu :global(.bandeau-annonce) {
    margin-inline: 0;
  }
  .apercu :global(a) {
    text-decoration: none;
  }
  .emojis {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .emojis button {
    padding: 0.2rem 0.45rem;
    font-size: 1.3rem;
    line-height: 1;
  }
  .emojis button:last-child {
    font-size: 0.85rem;
  }
  fieldset {
    display: grid;
    gap: 0.5rem;
    border: 1px solid var(--discret);
    border-radius: 0.3rem;
  }
  .case {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    color: inherit;
  }
</style>
