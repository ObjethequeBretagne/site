---
import Layout from "../layouts/layout.astro";
import Facebook from "../components/facebook.astro";
import NextEvents from "../components/nextevents.astro";
import Counter from "../components/counter.astro";
import Catalogue from "../components/myturncatalog.astro";
// import Videomp4 from "../components/videomp4.astro";
// import BandeauAnnonce from "../components/bandeau-annonce.astro";

// Import des images
import { Picture, getImage } from "astro:assets";
import illuPresa from "../assets/img/illuPresa.png";
import bullePanneau from "../assets/img/BullePanneau.png";
import bulleBenjamin from "../assets/img/BulleBenjamin.webp";
import boisClairHorizontal from "../assets/boiscrop.webp";
import YoutubeFacade from "../components/youtube-facade.astro";
import MapsFacade from "../components/maps-facade.astro";

const bgImage = await getImage({ src: boisClairHorizontal, format: "webp", width: 1920 });
---

<Layout title="Objetheque de Cornouaille" preloadImage={bgImage.src}>
  <main>
    <section class="presentation" style={`background-image: url('${bgImage.src}');`}>
      <h1>
        <div class="cadreBlancArrondi">
          <p class="presaTitre">
            Emprunte <span>sans limite</span>...
          </p>
          <p class="presaTitre">
            Et <span>limite</span> ton empreinte !
          </p>
        </div>
        <p class="presaSousTitre">Prêt d'objets, Réparation, Création.</p>
      </h1>
      <div class="presentation-image-container">
        <Picture
          src={illuPresa}
          formats={["avif", "webp"]}
          widths={[400, 800, 1200]}
          sizes="(max-width: 767px) 100vw, 50vw"
          alt="dessin d'une planète entourée d'objets et de personnes pour les réparer/entretenir"
          class="presentation-image"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </section>
    <Facebook />
    <h2>
      <span class="moon">Nos dates à venir !</span>
      <a class="plusplus star" href="agenda"> + </a>
      <p class="sousTexteH2">An deiziadoù da zont !</p>
    </h2>
    <NextEvents />
    <YoutubeFacade
      videoId="s75UXM0THHA"
      title="Présentation de l'Objethèque de Cornouaille"
    />
    <section class="photoTexte wrapReverse">
      <Picture
        src={bullePanneau}
        formats={["avif", "webp"]}
        widths={[300, 500, 700]}
        sizes="(max-width: 767px) 80vw, 40vw"
        alt="photo en forme de bulle de l'intérieur du local de l'objetheque"
      />
      <div>
        <p>
          Vous en avez assez d'acheter des objets que vous n'utilisez qu'une
          fois par an et qui prennent la poussière le reste du temps ?
          L'Objethèque de Cornouaille est la solution idéale pour vous !
        </p>
        <br />
        <p>
          Avec L'Objethèque de Cornouaille, vous pouvez emprunter une variété
          d'objets pour réaliser tous vos projets, sans dépenser une fortune.
          Notre catalogue en ligne propose une gamme d'objets que vous pouvez
          consulter et réserver facilement.
        </p>
        <br />
        <p class="textePlusClair">
          Et le meilleur dans tout ça ? Notre catalogue ne cesse de s'agrandir !
          Chaque mois, de nouveaux objets sont ajoutés, vous offrant encore plus
          d'options pour explorer vos passions et réaliser vos projets.
        </p>
        <br />
        <p>
          Rejoignez le mouvement aujourd'hui et dites adieu aux objets inutiles
          qui encombrent votre espace. Avec L'Objethèque de Cornouaille, vous
          pouvez vivre une vie plus simple, plus économique et plus durable.
        </p>
      </div>
    </section>
    <Counter />
    <section class="photoTexte">
      <div>
        <p>
          Vous avez des objets cassés qui traînent dans votre garage ou votre
          grenier ? Ne les jetez pas ! L'Objethèque de Cornouaille est là pour
          vous aider à leur donner une seconde vie.
        </p>
        <br />
        <p class="textePlusClair">
          Nous organisons régulièrement des ateliers pratiques de réparation et
          de fabrication zéro déchet. Ensemble, nous pouvons réparer vos
          vêtements et petits appareils ménagers comme des grille-pain,
          perceuses ou cafetière. Vous apprendrez également à fabriquer vos
          propres produits écologiques tels que des lingettes et des sacs à
          vrac.
        </p>
        <br />
        <p>
          Rejoignez-nous lors de nos prochains ateliers et découvrez comment
          vous pouvez contribuer à un mode de vie plus durable. Suivez notre
          actualité et n'hésitez pas à nous contacter pour plus d'informations !
          Ensemble, nous pouvons faire la différence.
        </p>
      </div>
      <Picture
        src={bulleBenjamin}
        formats={["avif", "webp"]}
        widths={[300, 500, 700]}
        sizes="(max-width: 767px) 80vw, 40vw"
        alt="photo en forme de bulle d'une personne qui pose avec des objets de l'objetheque"
      />
    </section>
    <Catalogue />
    <h2>
      Retrouvez-nous
      <span class="iconeGPSOrange-container">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="var(--primary-color)" width="38" height="38">
      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
      </svg>
      </span>
      <p class="sousTexteH2">Adkavit ac'hanomp</p>
    </h2>
    <MapsFacade
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2670.295213241934!2d-4.0644972!3d47.9886817!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4810d773657f2745%3A0x40ba5da19d1940bd!2sL'Objeth%C3%A8que%20de%20Cornouaille!5e0!3m2!1sfr!2sfr!4v1739277917549!5m2!1sfr!2sfr"
      title="Carte - Objethèque de Cornouaille"
      address="69, Vieille Route de Rosporden — 29000 Quimper"
      mapsUrl="https://maps.google.com/?q=L'Objeth%C3%A8que+de+Cornouaille,+69+Vieille+Route+de+Rosporden,+29000+Quimper"
    />
  </main>
</Layout>
