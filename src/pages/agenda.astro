---
import Layout from "../layouts/layout.astro";
---

<Layout title="Agenda">
  <main>
    <h2 class="h2PaddingTopSmall"></h2>
    <section id="agendaImage">
      <img
        class="imgCentre"
        src="activite.png"
        alt="programme octobre 2024"
      />
    </section>
    <a class="soulignementOrange" id="lienInscription" href="https://www.helloasso.com/associations/l-objetheque-de-cornouaille/evenements/atelier-couture-2"> 📝 Inscriptions pour l'atelier "couture thème libre" du 9/11</a>
    <a class="soulignementOrange" id="lienInscription" href="https://calendly.com/marylinebazin/atelier-ecologie-de-soi?back=1&month=2024-11"> 📝 Inscriptions pour l'atelier "écologie de soi" du 30/11</a>  
   </main>
</Layout>
<style>
  #lienInscription {
    color: var(--secondary-color);
    justify-self: center;
    display: flex;
    font-size: clamp(0.5rem, 1.5vw + 0.5rem, 1.5rem);
    font-weight: 900;
    max-width: 90%;
    margin-bottom: 3rem;
  }
  #agendaImage {
    overflow-x: auto;
    margin-bottom: 3rem;
  }
  #agendaImage img {
    min-width: 1000px;
    margin-bottom: 3rem;
  }
</style>
