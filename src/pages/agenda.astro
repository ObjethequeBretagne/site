---
import Layout from "../layouts/layout.astro";
import Calendrier from "../components/calendrier.astro";
import Lastevent from "../components/lastevent.astro";
---

<Layout title="Agenda">
  <main>
    <Calendrier />
    <Lastevent />
    <section style="display: none;" id="agendaImage">
      <img
        class="imgCentre"
        src="activite.jpg"
        alt="programme décembre 2024"
      />
    </section>
   </main>
</Layout>
<style>
  .lienInscription {
    color: var(--secondary-color);
    font-size: clamp(0.5rem, 1.5vw + 0.5rem, 1.5rem);
    font-weight: 900;
    max-width: 90%;
    margin-bottom: 3rem;
  }
  #agendaImage {
    overflow-x: auto;
    margin-bottom: 3rem;
  }
  #agendaImage img {
    min-width: 62rem;
    margin-bottom: 3rem;
  }
</style>
