---
import Layout from "../layouts/layout.astro";
import Calendrier from "../components/calendrier.astro";
---

<Layout title="Agenda">
  <main>
    <Calendrier />
    <section id="agendaImage">
      <img
        class="imgCentre"
        src="activite.jpg"
        alt="programme décembre 2024"
      />
    </section>
    <a class="soulignementOrange2 lienInscription" href="https://calendly.com/marylinebazin/atelier-ecologie-de-soi?back=1&month=2024-11"> 📝 Inscriptions pour l'atelier "écologie de soi" du 30/11, 21/12, 25/01 ou 22/02</a>  
   </main>
</Layout>
<style>
  .lienInscription {
    color: var(--secondary-color);
    justify-self: center;
    display: flex;
    font-size: clamp(0.5rem, 1.5vw + 0.5rem, 1.5rem);
    font-weight: 900;
    max-width: 90%;
    margin-bottom: 3rem;
  }
  #agendaImage {
    overflow-x: auto;
    margin-bottom: 3rem;
  }
  #agendaImage img {
    min-width: 62rem;
    margin-bottom: 3rem;
    border-radius: 8px;
  }
</style>
