  </main>
</Layout>
<style>
  .nosValeurs {
    display: flex;
    flex-direction: column;
    gap: calc(var(--marginBlock) / 2);
    margin-top: calc(var(--marginBlock) / 2);
    margin-bottom: var(--marginBlock);
  }
  .nosValeurs p {
    max-width: 65ch;
  }
</style>
