---
import presse from "../data/presse.json";
---

<section transition:animate="none" class="tabs-container">
  <ul aria-labelledby="les-medias">
    <li><a id="tab-1" href="#tout" data-tag="tout">Tout</a></li>
    <li><a id="tab-2" href="#presse" data-tag="presse">Presse</a></li>
    <li><a id="tab-3" href="#radio" data-tag="radio">Radio</a></li>
    <li><a id="tab-4" href="#TV" data-tag="TV">TV</a></li>
    <li><a id="tab-5" href="#web" data-tag="web">Web</a></li>
  </ul>
</section>
<section class="tabs__panels flow">
  {presse.map((article, i) => (
    <div id={`panel-${i + 1}`} aria-labelledby={`tab-${i + 1}`} data-tag={article.type}>
      <a target="_blank" href={article.href}>
        <img alt={`logo ${article.media}`} src={article.logo} loading="lazy" />{article.title}
      </a>
    </div>
  ))}
</section>
<style>
  .tabs-container {
    margin-left: var(--marginLeft);
  }
  .tabs-container ul {
    display: flex;
    margin-top: var(--marginBlock);
    gap: 2em;
  }
  .tabs-container ul li a {
    font-size: 12px;
    padding-bottom: 5px;
    color: var(--dark-text-color);
  }
  .tabs-container ul li a:visited {
    color: var(--dark-text-color);
    /* Set the color for visited links to the same value as unvisited links */
  }
  .tabs-container ul li a.active {
    border-bottom: 2px solid var(--dark-text-color);
  }

  .tabs__panels {
    display: flex;
    margin-left: var(--marginLeft);
    margin-block: var(--marginBlock);
    gap: calc(var(--marginBlock) / 2);
    overflow-x: auto;
  }
  .tabs__panels div a {
    color: var(--secondary-color);
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 200px;
  }
  .tabs__panels div a:hover {
    color: var(--primary-color);
  }
  @media (prefers-color-scheme: dark) {
    .tabs__panels div a:hover {
      color: var(--dark-text-color);
    }
  }

  .tabs__panels img {
    height: 100px;
    object-fit: contain;
  }
</style>
<script>
  document.addEventListener("astro:page-load", () => {
    /*script tab*/
    const tabsContainer = document.querySelector(".tabs-container");
    const tabsList = tabsContainer?.querySelector("ul");
    const tabButtons = tabsList?.querySelectorAll("li a");
    const tabPanels = document.querySelectorAll(".tabs__panels > div");

    // Show the panel with the "tout" tag
    const defaultPanel = document.querySelector('[data-tag="tout"]');
    if (defaultPanel) {
      defaultPanel.removeAttribute("hidden");
    }

    // Highlight the "Tout" tab
    const defaultTab = document.querySelector('[data-tag="tout"]');
    if (defaultTab) {
      defaultTab.classList.add("active");
    }

    tabsContainer?.addEventListener("click", (e) => {
      const clickedTab = (e.target as HTMLElement).closest("a");
      if (!clickedTab) return;
      e.preventDefault();

      // Remove the "active" class from all tabs
      tabButtons?.forEach((tab) => {
        tab.classList.remove("active");
      });

      // Add the "active" class to the clicked tab
      clickedTab.classList.add("active");
      switchTab(clickedTab);
    });

    function switchTab(newTab: HTMLElement) {
      const activeTag = newTab.getAttribute("data-tag");

      tabPanels.forEach((panel) => {
        const panelTag = panel.getAttribute("data-tag");
        if (panelTag === activeTag || activeTag === "tout") {
          panel.removeAttribute("hidden");
        } else {
          panel.setAttribute("hidden", "");
        }
      });
    }
  });
</script>
