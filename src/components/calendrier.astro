---
// src/components/calendrier.astro
interface Event {
  id: string;
  title: string;
  description: string;
  startDate: string;
  endDate: string;
  url: string;
  logoUrl: string;
  bannerUrl?: string;
  location?: string;
}
---

<div class="calendar-wrapper">
  <div class="calendar">
    <div class="calendar-header">
      <button class="nav-btn prev-btn" id="prev-month">&lt;</button>
      <h1 class="month-title" id="month-title"></h1>
      <button class="nav-btn next-btn" id="next-month">&gt;</button>
    </div>
    <div class="calendar-grid-header">
      <div class="day-name">Lun</div>
      <div class="day-name">Mar</div>
      <div class="day-name">Mer</div>
      <div class="day-name">Jeu</div>
      <div class="day-name">Ven</div>
      <div class="day-name">Sam</div>
      <div class="day-name">Dim</div>
    </div>
    <div class="calendar-grid" id="calendar-grid"></div>
  </div>

  <!-- Modal natif HTML5 -->
  <dialog id="event-modal" class="event-dialog">
    <div class="modal-content">
      <button class="close-btn" id="close-modal" aria-label="Fermer"
        >&times;</button
      >
      <h2 id="modal-title"></h2>
      <img id="modal-image" class="modal-image" alt="Image de l'événement" />
      <div id="modal-description"></div>
      <div class="modal-footer">
        <a id="modal-link" target="_blank" class="soulignementOrange">
          <span style="font-size: 1.5rem;">+</span> d'infos
        </a>
      </div>
    </div>
  </dialog>
</div>

<script>
  // Type definitions
  interface Event {
    id: string;
    title: string;
    description: string;
    startDate: string;
    endDate: string;
    url: string;
    logoUrl: string;
    bannerUrl?: string;
    location?: string;
  }

  class Calendar {
    private currentMonth: number;
    private currentYear: number;
    private events: Event[] = [];
    private monthTitle: HTMLElement;
    private calendarGrid: HTMLElement;
    private modal: HTMLDialogElement;
    private modalTitle: HTMLElement;
    private modalDescription: HTMLElement;
    private modalImage: HTMLImageElement;
    private modalLink: HTMLAnchorElement;

    private readonly months = [
      "Janvier",
      "Février",
      "Mars",
      "Avril",
      "Mai",
      "Juin",
      "Juillet",
      "Août",
      "Septembre",
      "Octobre",
      "Novembre",
      "Décembre",
    ];

    constructor() {
      const today = new Date();
      this.currentMonth = today.getMonth();
      this.currentYear = today.getFullYear();

      // Get DOM elements with type assertion
      this.monthTitle = document.getElementById("month-title")!;
      this.calendarGrid = document.getElementById("calendar-grid")!;
      this.modal = document.getElementById("event-modal") as HTMLDialogElement;
      this.modalTitle = document.getElementById("modal-title")!;
      this.modalDescription = document.getElementById("modal-description")!;
      this.modalImage = document.getElementById(
        "modal-image"
      ) as HTMLImageElement;
      this.modalLink = document.getElementById(
        "modal-link"
      ) as HTMLAnchorElement;

      this.init();
    }

    private async init(): Promise<void> {
      await this.loadEvents();
      this.setupEventListeners();
      this.updateCalendar();
    }

    private setupEventListeners(): void {
      // Navigation buttons
      document.getElementById("prev-month")?.addEventListener("click", () => {
        this.navigateMonth(-1);
      });

      document.getElementById("next-month")?.addEventListener("click", () => {
        this.navigateMonth(1);
      });

      // Modal close button
      document.getElementById("close-modal")?.addEventListener("click", () => {
        this.closeModal();
      });

      // Close modal on backdrop click
      this.modal?.addEventListener("click", (e: MouseEvent) => {
        if (e.target === this.modal) {
          this.closeModal();
        }
      });

      // Close modal on Escape key
      document.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "Escape" && this.modal?.open) {
          this.closeModal();
        }
      });
    }

    private navigateMonth(direction: number): void {
      this.currentMonth += direction;

      if (this.currentMonth < 0) {
        this.currentMonth = 11;
        this.currentYear--;
      } else if (this.currentMonth > 11) {
        this.currentMonth = 0;
        this.currentYear++;
      }

      this.updateCalendar();
    }

    private async loadEvents(): Promise<void> {
      try {
        const response = await fetch("/events.json");
        if (!response.ok)
          throw new Error(`HTTP error! status: ${response.status}`);

        const data: Event[] = await response.json();
        this.events = data;
        console.log("Événements chargés :", this.events.length);
      } catch (error) {
        console.error("Erreur de chargement des événements :", error);
        this.events = [];
      }
    }

    private updateCalendar(): void {
      if (!this.calendarGrid) return;

      // Clear the calendar
      this.calendarGrid.innerHTML = "";

      // Update month title
      if (this.monthTitle) {
        this.monthTitle.textContent = `${this.months[this.currentMonth]} ${this.currentYear}`;
      }

      // Calculate first day and days in month
      const firstDay = new Date(this.currentYear, this.currentMonth, 1);
      const lastDay = new Date(this.currentYear, this.currentMonth + 1, 0);
      const daysInMonth = lastDay.getDate();

      // Adjust for Monday as first day (0 = Monday, 6 = Sunday)
      const firstDayOfWeek = (firstDay.getDay() + 6) % 7;

      // Add empty cells for days before month starts
      for (let i = 0; i < firstDayOfWeek; i++) {
        const emptyCell = document.createElement("div");
        this.calendarGrid.appendChild(emptyCell);
      }

      // Add days of the month
      for (let day = 1; day <= daysInMonth; day++) {
        const dateStr = this.formatDate(
          this.currentYear,
          this.currentMonth,
          day
        );
        const dayCell = this.createDayCell(day, dateStr);
        this.calendarGrid.appendChild(dayCell);
      }
    }

    private formatDate(year: number, month: number, day: number): string {
      const monthStr = String(month + 1).padStart(2, "0");
      const dayStr = String(day).padStart(2, "0");
      return `${year}-${monthStr}-${dayStr}`;
    }

    private createDayCell(day: number, dateStr: string): HTMLElement {
      const dayCell = document.createElement("div");
      dayCell.textContent = String(day);

      // Check if there's an event on this day
      const event = this.findEventForDate(dateStr);

      if (event) {
        // Apply inline styles for event days (matching original)
        dayCell.style.cssText = `
          background: var(--primary-color);
          font-weight: bold;
          cursor: pointer;
          text-align: center;
          padding: 0.6rem;
          font-size: 1.3em;
          margin: 0.1rem;
          border-radius: 12px;
          transition: transform 0.2s ease, box-shadow 0.2s ease;
          color: var(--light-text-color);
        `;

        dayCell.setAttribute("data-event-id", event.id);
        dayCell.addEventListener("click", () => this.showEventModal(event));

        // Add hover effects
        dayCell.addEventListener("mouseenter", () => {
          dayCell.style.transform = "scale(1.05)";
          dayCell.style.boxShadow = "0 2px 8px rgba(0, 0, 0, 0.2)";
        });

        dayCell.addEventListener("mouseleave", () => {
          dayCell.style.transform = "scale(1)";
          dayCell.style.boxShadow = "none";
        });

        // Add title as tooltip
        dayCell.title = event.title;
      } else {
        // Apply inline styles for normal days (matching original)
        dayCell.style.cssText = `
          padding: 0.6rem;
          margin: 0.1rem;
          font-size: 1.3em;
        `;
      }

      return dayCell;
    }

    private findEventForDate(dateStr: string): Event | undefined {
      return this.events.find((event) => {
        // Extract date from startDate using substring to avoid timezone issues
        const eventDate = event.startDate.substring(0, 10);
        return eventDate === dateStr;
      });
    }

    private showEventModal(event: Event): void {
      if (!this.modal) return;

      // Set modal content
      if (this.modalTitle) this.modalTitle.textContent = event.title;

      if (this.modalDescription) {
        // Convert line breaks et \ to HTML
        this.modalDescription.innerHTML = event.description
          .replace(/\\'/g, "'")
          .replace(/\n/g, "<br>");
      }

      if (this.modalImage) {
        this.modalImage.src = event.logoUrl || "assets/img/logo.png";
        this.modalImage.alt = event.title;
      }

      if (this.modalLink) {
        this.modalLink.href = event.url;
      }

      // Show modal using native dialog API
      this.modal.showModal();
      document.body.classList.add("modal-open");
    }

    private closeModal(): void {
      if (!this.modal) return;

      this.modal.close();
      document.body.classList.remove("modal-open");
    }
  }

  // Initialize calendar when page loads
  document.addEventListener("astro:page-load", () => {
    new Calendar();
  });
</script>

<style>
  .calendar {
    width: 90%;
    background: var(--background-color);
    border-radius: 8px;
    box-shadow: 0 4px 10px var(--dark-shadow-color);
    overflow: hidden;
    margin-block: var(--marginBlock);
    margin-inline: auto;
    text-align: center;
    max-width: 60rem;
    padding-bottom: 0.3rem;
    color: var(--dark-text-color);
    min-height: 17rem;
  }

  .calendar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--grey-background);
    padding: 10px 20px;
    margin-bottom: 0.1em;
  }

  .month-title {
    font-size: 1.8em;
    font-weight: bold;
    padding-block: 0.4em;
  }

  .nav-btn {
    background: white;
    border: none;
    border-radius: 50%;
    width: 30px;
    height: 30px;
    font-size: 1em;
    color: var(--primary-color);
    cursor: pointer;
    transition:
      color 0.3s ease,
      background-color 0.3s ease;
  }

  .nav-btn:hover {
    background: var(--primary-color);
    color: white;
  }

  .calendar-grid,
  .calendar-grid-header {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.1rem;
    background: var(--background-color);
    margin-inline: auto;
  }

  .day-name {
    font-weight: bold;
    margin-block: 0.4rem;
    font-size: 1.4em;
  }

  @media (max-width: 480px) {
    .month-title {
      font-size: 1.2em;
    }
    .day-name {
      font-size: 1.1em;
    }
    .nav-btn {
      width: 25px;
      height: 25px;
      font-size: 0.8em;
    }
  }

  /* Native dialog styles */
  .event-dialog {
    margin: auto;
    border: none;
    border-radius: 8px;
    padding: 0;
    width: 90%;
    max-width: 500px;
    max-height: 90vh;
    overflow: visible;
    background: var(--background-color);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .modal-content {
    background: var(--background-color);
    padding: 20px 30px;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
  }

  .modal-content h2 {
    margin: 0 0 10px;
    font-size: 1.5em;
    color: var(--secondary-color);
  }

  #modal-description {
    margin: 0;
    font-size: 1.1em;
    color: var(--dark-text-color);
  }

  .modal-footer {
    margin-top: 4em;
    display: flex;
    justify-content: end;
  }

  .modal-image {
    width: 100%;
    object-fit: contain;
    margin-block: 1.5rem;
  }

  .close-btn {
    position: absolute;
    padding: 0.5rem;
    border-radius: 100%;
    top: 10px;
    right: 10px;
    background: none;
    border: none;
    font-size: 1.5em;
    color: #aaa;
    cursor: pointer;
    line-height: 1;
  }

  .close-btn:hover {
    color: var(--dark-text-color);
  }
</style>