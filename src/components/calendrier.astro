    margin-inline: auto;
    text-align: center;
    max-width: 1000px;
    padding-bottom: 0.3rem;
    min-height: 17rem;
  }

  .calendar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--grey-background);
    color: var(--dark-text-color);
    padding: 10px 20px;
  }

  .month-title {
    font-size: 1.5em;
    font-weight: bold;
  }

  .nav-btn {
    background: white;
    border: none;
    border-radius: 50%;
    width: 30px;
    height: 30px;
    font-size: 1em;
    color: #0077cc;
    cursor: pointer;
  }

  .nav-btn:hover {
    background: #0077cc;
    color: white;
  }

  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.1rem;
    background: #ddd;
    margin-inline: auto;
  }
  .calendar-grid-header {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.1rem;
    background: #ddd;
    margin-inline: auto;
  }

  .calendar-grid.day {
    background: white;
    text-align: center;
    padding: 15px 0;
    font-size: 1em;
    position: relative;
    cursor: pointer;
  }

  .day-name {
    font-weight: bold;
    margin-top: 0.3rem;
  }

  .day:hover {
    background: #f0f8ff;
  }

  @media (max-width: 480px) {
    .month-title {
      font-size: 1.2em;
    }
    .nav-btn {
      width: 25px;
      height: 25px;
      font-size: 0.8em;
    }
    .day {
      padding: 10px 0;
    }
  }

  .modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5); /* Fond semi-transparent */
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000; /* Assurez-vous que la modal est au-dessus de tout le reste */
  }

  .modal-content {
    background: var(--background-color);
    padding: 20px 30px;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    width: 90%;
    max-width: 500px;
    position: relative;
  }

  .modal-content h2 {
