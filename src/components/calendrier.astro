<div
  x-data="{ 
    modalOpen: false, 
    modalTitle: '', 
    modalDescription: '', 
    modalUrl: '', 
    modalImage: '',
    handleKeydown(event) {
      if (this.modalOpen) {
        if (event.key === 'Escape') {
          this.modalOpen = false;
        }
      }
    },
  }"
  x-init="$watch('modalOpen', value => { 
    document.body.classList.toggle('no-scroll', value); 
  })"
  
  role="dialog"
  aria-labelledby="modal-title"
  aria-hidden="true"
  @keydown.window="handleKeydown($event)"
>
  <div class="calendar">
    <div class="calendar-header">
      <button class="nav-btn prev-btn" onclick="navigateMonth(-1)">&lt;</button>
      <h1 class="month-title" id="month-title"></h1>
      <button class="nav-btn next-btn" onclick="navigateMonth(1)">&gt;</button>
    </div>
    <div class="calendar-grid-header" id="calendar-grid-header">
      <!-- Jours de la semaine -->
      <div class="day-name">Lun</div>
      <div class="day-name">Mar</div>
      <div class="day-name">Mer</div>
      <div class="day-name">Jeu</div>
      <div class="day-name">Ven</div>
      <div class="day-name">Sam</div>
      <div class="day-name">Dim</div>
    </div>
    <div class="calendar-grid" id="calendar-grid"></div>
  </div>

  <!-- Modal pour afficher les détails d'un événement -->
  <div
    style="display: none;"
    x-show="modalOpen"
    x-bind:class="{'modal-open': modalOpen}"
    @click.self="modalOpen = false"
    class="modal"
  >
    <div class="modal-content">
      <span class="close-btn" @click="modalOpen = false" tabindex="0"
        >&times;</span
      >
      <h2 x-text="modalTitle"></h2>
      <img :src="modalImage" alt="Image évént" class="modal-image" />
      <p x-html="modalDescription"></p>
      <div class="modal-footer">
        <a :href="modalUrl" target="_blank" class="soulignementOrange">
          <span style="font-size: 1.5rem;">+</span> d'infos
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Inclusion du script pour récupérer les événements et afficher le calendrier -->
<script type="module" src="../scripts/calendar.js"></script>

<style>
  .calendar {
    width: 90%;
    background: var(--background-color);
    border-radius: 8px;
    box-shadow: 0 4px 10px var(--dark-shadow-color);
    overflow: hidden;
    margin-block: var(--marginBlock);
    margin-inline: auto;
    text-align: center;
    max-width: 60rem;
    padding-bottom: 0.3rem;    
    color: var(--dark-text-color);

    min-height: 17rem;
  }

  .calendar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--grey-background);
    padding: 10px 20px;
    margin-bottom: 0.1em;
  }

  .month-title {
    font-size: 1.8em;
    font-weight: bold;
    padding-block: 0.4em;
  }

  .nav-btn {
    background: white;
    border: none;
    border-radius: 50%;
    width: 30px;
    height: 30px;
    font-size: 1em;
    color: var(--primary-color);
    cursor: pointer;
  }

  .nav-btn:hover {
    background: var(--primary-color);
    color: white;
  }

  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.1rem;
    background: var(--background-color);
    margin-inline: auto;
    font-size: 1em;
  }
  .calendar-grid-header {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.1rem;
    background: var(--background-color);
    margin-inline: auto;
  }

  .calendar-grid.day {
    background: white;
    text-align: center;
    padding: 15px 0;
    font-size: 1em;
    position: relative;
    cursor: pointer;
  }

  .day-name {
    font-weight: bold;
    margin-block: 0.4rem;
    font-size: 1.4em;
  }

  .day:hover {
    background: #f0f8ff;
  }

  @media (max-width: 480px) {
    .month-title {
      font-size: 1.2em;
    }
    .day-name {
      font-size: 1.1em;
    }
    .nav-btn {
      width: 25px;
      height: 25px;
      font-size: 0.8em;
    }
  }

  .modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5); /* Fond semi-transparent */
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000; /* Assurez-vous que la modal est au-dessus de tout le reste */
  }
  
  .modal-content {
    background: var(--background-color);
    padding: 20px 30px;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    width: 90%;
    max-width: 500px;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
  }

  .modal-content h2 {
    margin: 0 0 10px;
    font-size: 1.5em;
    color: var(--secondary-color);
  }

  .modal-content p {
    margin: 0;
    font-size: 1.1em;
    color: var(--dark-text-color);
  }

  .modal-footer {
    margin-top: 4em;
    display: flex;
    justify-content: end;
  }

  .modal-image {
    width: 100%;
    object-fit: contain;
    margin-block: 1.5rem;
  }

  .close-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    background: none;
    border: none;
    font-size: 1.5em;
    color: #aaa;
    cursor: pointer;
    line-height: 1;
  }

  .close-btn:hover {
    color: var(--dark-text-color);
  }

  body.no-scroll {
    overflow: hidden;
  }
</style>