---
import donnees from "../data/annonce.json";

// Bandeau d'annonce de l'accueil, édité depuis /admin/annonce. Masqué tant que
// « afficher » est faux ; le bouton n'apparaît que si un lien est renseigné.
// En aperçu (admin), tout est rendu, les parties vides en `hidden`, et repéré par
// data-apercu pour que le formulaire les mette à jour pendant la saisie.
interface Props {
  annonce?: typeof donnees;
  apercu?: boolean;
}
const { annonce = donnees, apercu = false } = Astro.props;
const externe = /^https?:\/\//.test(annonce.lienHref);
const pdf = annonce.lienHref.endsWith(".pdf");
const repere = (nom: string) => (apercu ? nom : undefined);
---

{(annonce.afficher || apercu) && (
  <section class="bandeau-annonce">
    <div class="bandeau-content">
      {(annonce.icone || apercu) && <div class="bandeau-icon" hidden={!annonce.icone} data-apercu={repere("icone")}>{annonce.icone}</div>}
      <div class="bandeau-text">
        <h3 data-apercu={repere("titre")}>{annonce.titre}</h3>
        {(annonce.texte || apercu) && <p hidden={!annonce.texte} data-apercu={repere("texte")}>{annonce.texte}</p>}
      </div>
      {(annonce.lienHref || apercu) && (
        <div class="bandeau-action" hidden={!annonce.lienHref} data-apercu={repere("action")}>
          <a href={annonce.lienHref} class="bouton-annonce" target={externe || pdf ? "_blank" : undefined}>
            <span data-apercu={repere("libelle")}>{annonce.lienLibelle}</span>
            {(pdf || apercu) && <img src="/assets/img/pdf-logo.png" alt="PDF" class="pdf-icon" hidden={!pdf} data-apercu={repere("pdf")} />}
          </a>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .bandeau-annonce {
    margin: 2rem;
  }

  .bandeau-content {
    border-radius: 15px;
    padding: 1rem;
    background-color: var(--grey-background);
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
    gap: 1rem;
  }

  .bandeau-icon {
    font-size: 3rem;
    min-width: 60px;
  }

  .bandeau-text {
    flex: 1;
  }

  .bandeau-text h3 {
    margin: 0;
    text-wrap: balance;
    font-size: 1.4rem;
    font-weight: bold;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
  }

  .bandeau-text p {
    margin: 0.25rem 0 0 0;
    text-wrap: balance;
    font-size: 1rem;
  }

  .bouton-annonce {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--primary-color);
    color: var(--light-text-color);
    padding: 0.75rem 1.5rem;
    border-radius: 30px;
    font-weight: bold;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    white-space: nowrap;
  }

  .bouton-annonce:hover {
    scale: 1.1;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  }

  .pdf-icon {
    height: 2.3rem;
    width: auto;
  }

  /* Responsive */
  @media screen and (max-width: 768px) {
    .bandeau-content {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }

    .bandeau-text h3 {
      font-size: 1.2rem;
    }

    .bandeau-text p {
      font-size: 0.9rem;
    }

    .bouton-annonce {
      padding: 0.6rem 1.2rem;
      font-size: 0.9rem;
    }
  }

  @media screen and (max-width: 480px) {
    .bandeau-annonce {
      margin-inline: 1rem;
      padding: 0.8rem;
    }

    .bandeau-content {
      gap: 0.8rem;
    }

    .bandeau-text h3 {
      font-size: 1.1rem;
    }

    .bouton-annonce {
      padding: 0.5rem 1rem;
      font-size: 0.8rem;
    }
  }
</style>