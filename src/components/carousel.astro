---
// Composant carrousel repensé pour l'Objethèque
import { Picture } from "astro:assets";

// Import des images du carrousel
import carousel1 from "../assets/img/carousel1.png";
import carousel2 from "../assets/img/carousel2.png";
import carousel3 from "../assets/img/carousel3.png";
import carousel4 from "../assets/img/carousel4.png";
import carousel5 from "../assets/img/carousel5.png";
import carousel6 from "../assets/img/carousel6.png";
import carousel7 from "../assets/img/carousel7.png";

// Tableau des images du carrousel
const carouselImages = [
  carousel1, carousel2, carousel3, carousel4, carousel5, carousel6, carousel7
];
---

<div class="carousel-container">
  <!-- Conteneur des flèches et du carrousel -->
  <div class="carousel-wrapper">
    <!-- Flèche gauche (extérieure) -->
    <label id="prevBtn" class="carousel-control prev" aria-label="Image précédente">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15,18 9,12 15,6"></polyline>
      </svg>
    </label>

    <!-- Carrousel central -->
    <div class="carousel">
      <div class="carousel-inner">
        {carouselImages.map((image, index) => (
          <>
            <input
              class="carousel-open"
              type="radio"
              id={`carousel-${index + 1}`}
              name="carousel"
              aria-hidden="true"
              hidden=""
              checked={index === 0}
            />
            <div class="carousel-item">
              <Picture
                src={image}
                formats={["avif", "webp", "png"]}
                alt={`Slide ${index + 1}`}
                widths={[600]}
                sizes="100vw"
                loading={index === 0 ? "eager" : "lazy"}
              />
            </div>
          </>
        ))}
      </div>
    </div>

    <!-- Flèche droite (extérieure) -->
    <label id="nextBtn" class="carousel-control next" aria-label="Image suivante">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="9,18 15,12 9,6"></polyline>
      </svg>
    </label>
  </div>

  <!-- Indicateurs en dessous du carrousel -->
  <ol class="carousel-indicators">
    {carouselImages.map((_, index) => (
      <li>
        <label for={`carousel-${index + 1}`} class="carousel-bullet" aria-label={`Aller à l'image ${index + 1}`}>•</label>
      </li>
    ))}
  </ol>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const prevBtn = document.getElementById("prevBtn")!;
    const nextBtn = document.getElementById("nextBtn")!;
    const carouselItems = document.querySelectorAll(".carousel-open");
    const bullets = document.querySelectorAll(".carousel-bullet");
    const carouselInner = document.querySelector(".carousel-inner") as HTMLElement;

    let currentIndex = 0;
    let startX = 0;
    let isDragging = false;

    function updateButtons() {
      const prevIndex =
        (currentIndex - 1 + carouselItems.length) % carouselItems.length;
      const nextIndex = (currentIndex + 1) % carouselItems.length;

      prevBtn.setAttribute("for", `carousel-${prevIndex + 1}`);
      nextBtn.setAttribute("for", `carousel-${nextIndex + 1}`);
    }

    function updateBullets() {
      bullets.forEach((bullet, index) => {
        bullet.classList.toggle('active', index === currentIndex);
      });
    }

    function goToSlide(index: number) {
      const targetItem = carouselItems[index] as HTMLInputElement;
      if (targetItem) {
        targetItem.checked = true;
        currentIndex = index;
        updateButtons();
        updateBullets();
      }
    }

    function nextSlide() {
      const nextIndex = (currentIndex + 1) % carouselItems.length;
      goToSlide(nextIndex);
    }

    function prevSlide() {
      const prevIndex = (currentIndex - 1 + carouselItems.length) % carouselItems.length;
      goToSlide(prevIndex);
    }

    // Gestion du swipe tactile
    function handleTouchStart(e: TouchEvent) {
      startX = e.touches[0].clientX;
      isDragging = true;
    }

    function handleTouchMove(e: TouchEvent) {
      if (!isDragging) return;
      e.preventDefault();
    }

    function handleTouchEnd(e: TouchEvent) {
      if (!isDragging) return;
      
      const endX = e.changedTouches[0].clientX;
      const diffX = startX - endX;
      const threshold = 50; // Seuil minimum pour déclencher le swipe

      if (Math.abs(diffX) > threshold) {
        if (diffX > 0) {
          nextSlide(); // Swipe vers la gauche = slide suivant
        } else {
          prevSlide(); // Swipe vers la droite = slide précédent
        }
      }

      isDragging = false;
    }

    // Événements existants
    carouselItems.forEach((item, index) => {
      item.addEventListener("change", () => {
        currentIndex = index;
        updateButtons();
        updateBullets();
      });
    });

    // Événements tactiles
    if (carouselInner) {
      carouselInner.addEventListener("touchstart", handleTouchStart, { passive: true });
      carouselInner.addEventListener("touchmove", handleTouchMove, { passive: false });
      carouselInner.addEventListener("touchend", handleTouchEnd, { passive: true });
    }

    // Initialisation
    updateButtons();
    updateBullets();
  });
</script>

<style>
  /* Conteneur principal - SANS overflow hidden */
  .carousel-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    margin: var(--marginBlock) auto;
    max-width: 800px;
    width: 100%;
  }

  /* Conteneur des flèches et du carrousel */
  .carousel-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    width: 100%;
  }

  /* Le carrousel lui-même */
  .carousel {
    position: relative;
    width: 100%;
    max-width: 600px;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    overflow: hidden; /* Ici c'est OK car les flèches sont à l'extérieur */
  }

  .carousel-inner {
    width: 100%;
    position: relative;
  }

  .carousel-open:checked + .carousel-item {
    position: static;
    opacity: 1;
  }

  .carousel-item {
    position: absolute;
    opacity: 0;
    transition: opacity 0.4s ease-in-out;
    width: 100%;
  }

  .carousel-item picture,
  .carousel-item img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
  }

  /* Flèches de navigation - EXTÉRIEURES au carrousel */
  .carousel-control {
    width: 50px;
    height: 50px;
    background: rgba(255, 255, 255, 0.95);
    border: 2px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    flex-shrink: 0; /* Empêche les flèches de rétrécir */
  }

  .carousel-control:hover {
    background: var(--primary-color, #ff9500);
    border-color: var(--primary-color, #ff9500);
  }

  .carousel-control svg {
    width: 24px;
    height: 24px;
    color: var(--dark-text-color, #333);
  }

  .carousel-control:hover svg {
    color: white;
  }

  /* Indicateurs en dessous du carrousel */
  .carousel-indicators {
    display: flex;
    gap: 12px;
    justify-content: center;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .carousel-bullet {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid var(--dark-text-color, #333);
    background: var(--grey-background, #f5f5f5);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0;
    color: transparent;
  }

  .carousel-bullet:hover {
    background: var(--primary-color, #ff9500);
    border-color: var(--primary-color, #ff9500);
  }

  /* État actif du bullet */
  .carousel-bullet.active {
    background: var(--secondary-color, #0077cc);
    border-color: var(--secondary-color, #0077cc);
  }

  .carousel-bullet.active:hover {
    background: var(--primary-color, #ff9500);
    border-color: var(--primary-color, #ff9500);
  }

  /* Responsive - Mobile */
  @media (max-width: 768px) {
    .carousel-wrapper {
      gap: 15px;
      margin-inline: 1rem;
    }

    .carousel-control {
      width: 45px;
      height: 45px;
    }

    .carousel-control svg {
      width: 20px;
      height: 20px;
    }

    .carousel-bullet {
      width: 14px;
      height: 14px;
    }
  }

  /* Très petit écran - on cache les flèches */
  @media (max-width: 480px) {
    .carousel-control {
      display: none; /* On cache complètement les flèches sur mobile */
    }

    .carousel-bullet {
      width: 12px;
      height: 12px;
    }

    /* Ajouter un curseur pour indiquer qu'on peut swiper */
    .carousel-inner {
      cursor: grab;
      user-select: none;
    }

    .carousel-inner:active {
      cursor: grabbing;
    }
  }

  /* Focus accessibilité */
  .carousel-control:focus,
  .carousel-bullet:focus {
    outline: 2px solid var(--primary-color, #ff9500);
    outline-offset: 2px;
  }
</style>