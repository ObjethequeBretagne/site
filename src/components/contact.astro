<!-- Composant de formulaire de contact -->
<details
  class="contact-details"
  id="contact-form-details"
>
  <summary>Contactez-nous</summary>

  <form class="contact-form">
    <!-- Clé d'accès Web3Forms -->
    <input
      type="hidden"
      name="access_key"
      value="602b6784-99d2-4c70-957b-6095f28ba6b9"
    />

    <!-- Protection anti-spam -->
    <input type="hidden" name="botcheck" />

    <!-- Informations de base du formulaire -->
    <input type="hidden" name="from_name" value="Objethèque Cornouaille" />
    <input
      type="hidden"
      name="subject"
      value="Nouveau message de contact - Objethèque"
    />

    <!-- Catégorie de demande -->
    <div class="form-item">
      <label for="category">Objet</label>
      <select id="category" name="category" required>
        <option value="">Choisir un sujet</option>
        <option value="Emprunt">Question sur un emprunt</option>
        <option value="Don">Proposition de don</option>
        <option value="Bénévolat">Devenir bénévole</option>
        <option value="Partenariat">Proposer un partenariat</option>
        <option value="Autre">Autre demande</option>
      </select>
    </div>

    <!-- Champs du formulaire -->
    <div class="form-item">
      <label for="name">Nom</label>
      <input type="text" id="name" name="name" required />
    </div>

    <div class="form-item">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required />
    </div>

    <div class="form-item">
      <label for="message">Message</label>
      <textarea id="message" name="message" rows="6" required></textarea>
    </div>

    <!-- Notification RGPD -->
    <div class="form-item rgpd-container">
      <label class="rgpd-label">
        <input type="checkbox" name="gdpr" required />
        <span>En soumettant ce formulaire, j'accepte que mes données soient
          utilisées uniquement pour me recontacter.</span>
      </label>
    </div>

    <!-- Bouton d'envoi -->
    <div class="submit-container">
      <div class="boutonOrange" id="submit-wrapper">
        <button type="submit" id="submit-btn">
          <p id="submit-label" style="display: flex; justify-content: center;">Envoyer</p>
        </button>
      </div>
    </div>

    <!-- Messages de statut -->
    <div id="form-success" class="form-status success" hidden>
      <p>Merci pour votre message ! Nous vous répondrons dans les plus brefs délais.</p>
    </div>

    <div id="form-error" class="form-status error" hidden>
      <p>Une erreur s'est produite. Veuillez réessayer ou nous contacter directement.</p>
    </div>
  </form>
</details>

<style>
  .contact-details {
    color: var(--dark-text-color);
    border-radius: 8px;
    overflow: hidden;
    margin-inline: 1%;
    transition: all 0.3s ease;
  }

  .contact-details summary {
    display: flex;
    justify-content: center;
    cursor: pointer;
    padding: 0.8em;
    padding-inline: 1.2em;
    font-weight: bold;
    border-radius: 4px;
    transition: all 0.2s ease;
    font-size: larger;
    background-color: var(--grey-background);
    &::before {
      content: '';
      display: none;
      margin-inline-end: 0ch;
      transition: none;
    }
  }
  
  .contact-details summary:hover {
    color: var(--primary-color);
  }

  .contact-details[open] summary {
    margin-bottom: 1rem;
  }

  /* Pour l'animation d'ouverture */
  .contact-details summary ~ * {
    animation: slideDown 0.3s ease-out;
  }

  /* Animation de fermeture */
  .contact-details.closing > form {
    animation: slideUp 0.3s ease-in forwards;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideUp {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-10px);
    }
  }

  .contact-form {
    display: grid;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    padding-inline: 2%;
  }

  .form-item {
    margin-bottom: 1rem;
    width: 100%;
    color: var(--dark-text-color);
  }

  .form-item label {
    display: block;
    font-size: small;
    margin-bottom: 0.3rem;
    font-weight: 600;
    color: var(--dark-text-color);
  }

  .form-item input,
  .form-item textarea,
  .form-item select {
    width: 100%;
    padding: 0.5rem;
    border: 1px solid var(--dark-text-color);
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--dark-text-color);
    font-family: Muli, system-ui, sans-serif;
  }

  /* Style pour le select et les options */
  .form-item select {
    color: var(--dark-text-color);
    border: 1px solid var(--dark-text-color);
  }

  /* Styles pour les options du menu déroulant */
  .form-item select option {
    background-color: var(--grey-background);
  }

  /* Pour Webkit (Chrome, Safari) */
  .form-item select::selection {
    background-color: var(--grey-background);
  }

  /* Fix pour autofill sur Chrome/Safari */
  input:-webkit-autofill,
  input:-webkit-autofill:hover, 
  input:-webkit-autofill:focus,
  input:-webkit-autofill:active {
    transition: background-color 5000s ease-in-out 0s, color 5000s ease-in-out 0s;
    -webkit-text-fill-color: var(--dark-text-color) !important;
    background-clip: content-box !important;
  }

  .form-item input:focus,
  .form-item textarea:focus,
  .form-item select:focus {
    outline: none;
    border-color: var(--primary-color);
    background-color: rgba(255, 255, 255, 0.15);
  }

  .rgpd-container {
    margin-bottom: 1rem;
  }

  .rgpd-label {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    color: var(--dark-text-color);
    font-size: 0.8em;
  }

  .rgpd-label input {
    width: auto !important;
    margin-top: 0.2rem;
  }

  .submit-container {
    display: flex;
    align-items: center;
    margin-inline: auto;
    margin-bottom: 1rem;
  }

  /* Adaptation du bouton pour le footer */
  .contact-form .boutonOrange button {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    width: 100%;
  }

  .contact-form .boutonOrange p {
    margin: 0;
    padding: 8px 16px;
    font-size: 1.2em;
  }

  .contact-form .boutonOrange.disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  /* Messages de statut */
  .form-status {
    margin-top: 1rem;
    padding: 0.75rem;
    border-radius: 4px;
    text-align: center;
  }

  .form-status.success {
    background-color: var(--footer-color);
    margin-block: 0.5rem;
  }

  .form-status.error {
    background-color: rgba(255, 153, 0, 0.2);
    margin-block: 0.5rem;
  }

  .form-status p {
    margin: 0;
    color: var(--light-text-color);
    font-size: 1.2em;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const details = document.getElementById('contact-form-details');
    if (!details) return;

    // Animation fermeture du details
    const summary = details.querySelector('summary');
    if (summary) {
      let isAnimating = false;
      summary.addEventListener('click', (event) => {
        if (isAnimating) { event.preventDefault(); return; }
        if (details.hasAttribute('open')) {
          event.preventDefault();
          isAnimating = true;
          details.classList.add('closing');
          setTimeout(() => {
            details.removeAttribute('open');
            details.classList.remove('closing');
            isAnimating = false;
          }, 300);
        } else {
          setTimeout(() => {
            const rect = details.getBoundingClientRect();
            if (rect.bottom > window.innerHeight) {
              window.scrollTo({ top: window.scrollY + rect.top - 50, behavior: 'smooth' });
            }
          }, 50);
        }
      });
    }

    // Soumission du formulaire
    const form = details.querySelector('form');
    if (!form) return;

    const btn = document.getElementById('submit-btn') as HTMLButtonElement;
    const wrapper = document.getElementById('submit-wrapper')!;
    const label = document.getElementById('submit-label')!;
    const successMsg = document.getElementById('form-success')!;
    const errorMsg = document.getElementById('form-error')!;

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      btn.disabled = true;
      wrapper.classList.add('disabled');
      label.textContent = 'Envoi...';
      successMsg.hidden = true;
      errorMsg.hidden = true;

      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(form as HTMLFormElement),
      })
        .then(r => r.json())
        .then(data => {
          if (data.success) {
            successMsg.hidden = false;
            (form as HTMLFormElement).reset();
          } else {
            errorMsg.hidden = false;
          }
        })
        .catch(() => { errorMsg.hidden = false; })
        .finally(() => {
          btn.disabled = false;
          wrapper.classList.remove('disabled');
          label.textContent = 'Envoyer';
        });
    });
  });
</script>