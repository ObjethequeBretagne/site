<!-- Composant de formulaire de contact -->
<button id="contact-open-btn" class="contact-trigger" data-contact-open>Contactez-nous</button>

<dialog id="contact-modal" aria-labelledby="contact-modal-title">
  <div class="modal-header">
    <h2 id="contact-modal-title">Contactez-nous</h2>
    <button id="contact-close-btn" class="modal-close" aria-label="Fermer le formulaire">✕</button>
  </div>

  <form class="contact-form">
    <!-- Clé d'accès Web3Forms -->
    <input
      type="hidden"
      name="access_key"
      value="602b6784-99d2-4c70-957b-6095f28ba6b9"
    />

    <!-- Protection anti-spam -->
    <input type="hidden" name="botcheck" />

    <!-- Informations de base du formulaire -->
    <input type="hidden" name="from_name" value="Objethèque Cornouaille" />
    <input
      type="hidden"
      name="subject"
      value="Nouveau message de contact - Objethèque"
    />

    <!-- Catégorie de demande -->
    <div class="form-item">
      <label for="category">Objet</label>
      <select id="category" name="category" required>
        <option value="">Choisir un sujet</option>
        <option value="Emprunt">Question sur un emprunt</option>
        <option value="Don">Proposition de don</option>
        <option value="Bénévolat">Devenir bénévole</option>
        <option value="Partenariat">Proposer un partenariat</option>
        <option value="Autre">Autre demande</option>
      </select>
    </div>

    <!-- Champs du formulaire -->
    <div class="form-item">
      <label for="name">Nom</label>
      <input type="text" id="name" name="name" required />
    </div>

    <div class="form-item">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required />
    </div>

    <div class="form-item">
      <label for="message">Message</label>
      <textarea id="message" name="message" rows="6" required></textarea>
    </div>

    <!-- Notification RGPD -->
    <div class="form-item rgpd-container">
      <label class="rgpd-label">
        <input type="checkbox" name="gdpr" required />
        <span> En soumettant ce formulaire, j'accepte que mes données soient
          utilisées uniquement pour me recontacter.</span>
      </label>
    </div>

    <!-- Bouton d'envoi -->
    <div class="submit-container">
      <div class="boutonOrange" id="submit-wrapper">
        <button type="submit" id="submit-btn">
          <p id="submit-label" style="display: flex; justify-content: center;">Envoyer</p>
        </button>
      </div>
    </div>

    <!-- Messages de statut -->
    <div id="form-success" class="form-status success" hidden>
      <p>Merci pour votre message ! Nous vous répondrons dans les plus brefs délais.</p>
    </div>

    <div id="form-error" class="form-status error" hidden>
      <p>Une erreur s'est produite. Veuillez réessayer ou nous contacter directement.</p>
    </div>
  </form>
</dialog>

<style>
  .contact-trigger {
    display: flex;
    justify-content: center;
    cursor: pointer;
    padding: 0.8em 1.8em;
    font-weight: bold;
    border-radius: 4px;
    font-size: larger;
    background-color: rgba(231, 231, 231, 0.25);
    color: var(--light-text-color);
    border: 1px solid rgba(255, 255, 255, 0.35);
    width: fit-content;
    transition: background-color 0.2s ease;
    font-family: Muli, system-ui, sans-serif;
  }

  .contact-trigger:hover {
    background-color: rgba(231, 231, 231, 0.4);
  }

  #contact-modal {
    background-color: var(--background-color);
    border: none;
    border-radius: 12px;
    padding: 0;
    width: min(560px, 92vw);
    max-height: 90dvh;
    overflow-y: auto;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
    color: var(--dark-text-color);
    margin: auto;
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.2rem 1.5rem 0.8rem;
    border-bottom: 1px solid var(--grey-background);
  }

  .modal-header h2 {
    margin: 0;
    font-size: 1.3rem;
    color: var(--dark-text-color);
  }

  .modal-close {
    background: none;
    border: none;
    font-size: 1.4rem;
    cursor: pointer;
    color: var(--dark-text-color);
    line-height: 1;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .modal-close:hover {
    color: var(--primary-color);
    background-color: var(--grey-background);
  }

  .contact-form {
    display: grid;
    width: 100%;
    padding: 1.2rem 1.5rem 1.5rem;
  }

  .form-item {
    margin-bottom: 1rem;
    width: 100%;
    color: var(--dark-text-color);
  }

  .form-item label {
    display: block;
    font-size: small;
    margin-bottom: 0.3rem;
    font-weight: 600;
    color: var(--dark-text-color);
  }

  .form-item input,
  .form-item textarea,
  .form-item select {
    width: 100%;
    padding: 0.5rem;
    border: 1px solid var(--dark-text-color);
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--dark-text-color);
    font-family: Muli, system-ui, sans-serif;
  }

  .form-item select option {
    background-color: var(--grey-background);
  }

  /* Fix pour autofill sur Chrome/Safari */
  input:-webkit-autofill,
  input:-webkit-autofill:hover,
  input:-webkit-autofill:focus,
  input:-webkit-autofill:active {
    transition: background-color 5000s ease-in-out 0s, color 5000s ease-in-out 0s;
    -webkit-text-fill-color: var(--dark-text-color) !important;
    background-clip: content-box !important;
  }

  .form-item input:focus,
  .form-item textarea:focus,
  .form-item select:focus {
    outline: none;
    border-color: var(--primary-color);
    background-color: rgba(255, 255, 255, 0.15);
  }

  .rgpd-label {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    color: var(--dark-text-color);
    font-size: 0.8em;
  }

  .rgpd-label input {
    width: auto !important;
    margin-top: 0.2rem;
  }

  .submit-container {
    display: flex;
    align-items: center;
    margin-inline: auto;
    margin-bottom: 1rem;
  }

  .contact-form .boutonOrange button {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    width: 100%;
  }

  .contact-form .boutonOrange p {
    margin: 0;
    padding: 8px 16px;
    font-size: 1.2em;
  }

  .contact-form .boutonOrange.disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .form-status {
    margin-top: 1rem;
    padding: 0.75rem;
    border-radius: 4px;
    text-align: center;
  }

  .form-status.success {
    background-color: var(--footer-color);
    margin-block: 0.5rem;
  }

  .form-status.error {
    background-color: rgba(255, 153, 0, 0.2);
    margin-block: 0.5rem;
  }

  .form-status p {
    margin: 0;
    color: var(--light-text-color);
    font-size: 1.2em;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const modal = document.getElementById('contact-modal') as HTMLDialogElement | null;
    if (!modal) return;

    // Tout élément marqué [data-contact-open] ouvre le formulaire : le bouton du
    // footer, mais aussi les boutons « Nous contacter » placés dans les pages.
    const openBtns = document.querySelectorAll('[data-contact-open]');
    const closeBtn = document.getElementById('contact-close-btn');

    openBtns.forEach(btn =>
      btn.addEventListener('click', () => {
        if (!modal.open) modal.showModal();
      })
    );
    closeBtn?.addEventListener('click', () => modal.close());

    // Fermer en cliquant sur le backdrop
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    // Réinitialiser le formulaire à la fermeture
    modal.addEventListener('close', () => {
      const form = modal.querySelector('form');
      form?.reset();
      const successMsg = document.getElementById('form-success')!;
      const errorMsg = document.getElementById('form-error')!;
      successMsg.hidden = true;
      errorMsg.hidden = true;
    });

    // Soumission du formulaire
    const form = modal.querySelector('form');
    if (!form) return;

    const btn = document.getElementById('submit-btn') as HTMLButtonElement;
    const wrapper = document.getElementById('submit-wrapper')!;
    const label = document.getElementById('submit-label')!;
    const successMsg = document.getElementById('form-success')!;
    const errorMsg = document.getElementById('form-error')!;

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      btn.disabled = true;
      wrapper.classList.add('disabled');
      label.textContent = 'Envoi...';
      successMsg.hidden = true;
      errorMsg.hidden = true;

      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(form as HTMLFormElement),
      })
        .then(r => r.json())
        .then(data => {
          if (data.success) {
            successMsg.hidden = false;
            (form as HTMLFormElement).reset();
          } else {
            errorMsg.hidden = false;
          }
        })
        .catch(() => { errorMsg.hidden = false; })
        .finally(() => {
          btn.disabled = false;
          wrapper.classList.remove('disabled');
          label.textContent = 'Envoyer';
        });
    });
  });
</script>
