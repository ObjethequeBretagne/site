---
const { showAll = false } = Astro.props;
---

<section id="next-events-section" data-show-all={showAll}>
  <div id="nextevents-loading" class="loading-indicator">
    <p>Chargement des événements...</p>
  </div>
  <div id="nextevents-list" class="derniersEvenementsGridAll" hidden></div>
  <div id="nextevents-empty" class="no-events" hidden>
    <p>Aucun événement à venir pour le moment.</p>
  </div>
</section>

<script>
  function escHtml(str: string) {
    return str.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
  }

  document.addEventListener("astro:page-load", () => {
    const section = document.getElementById("next-events-section");
    if (!section) return;

    const showAll = section.dataset.showAll === "true";
    const loading = document.getElementById("nextevents-loading")!;
    const list = document.getElementById("nextevents-list")!;
    const empty = document.getElementById("nextevents-empty")!;

    fetch("/events.json")
      .then(r => r.json())
      .then((data: any[]) => {
        const today = new Date();
        let events = data
          .filter(e => new Date(e.startDate) > today)
          .sort((a, b) => +new Date(a.startDate) - +new Date(b.startDate));

        if (!showAll) events = events.slice(0, 4);

        loading.hidden = true;

        if (events.length === 0) {
          empty.hidden = false;
          return;
        }

        list.innerHTML = events.map(event => {
          const start = new Date(event.startDate);
          const end = new Date(event.endDate);
          const fr = "fr-FR";
          const jour = start.toLocaleDateString(fr, { weekday: "long" });
          const date = start.getDate();
          const mois = start.toLocaleDateString(fr, { month: "long" });
          const fmt = { hour: "2-digit" as const, minute: "2-digit" as const };
          const heureDebut = start.toLocaleTimeString(fr, fmt);
          const heureFin = end.toLocaleTimeString(fr, fmt);
          const url = escHtml(event.url ?? "#");
          const logo = escHtml(event.logoUrl ?? "");
          const titre = escHtml(event.title ?? "");

          return `
            <div class="derniersEvenementsGrid1">
              <a href="${url}" target="_blank" rel="noopener">
                <img class="imgEvent" src="${logo}" alt="${titre}" loading="lazy" />
              </a>
              <div class="dateEvent">
                <p class="jourLEvent">${jour}</p>
                <p class="jourNEvent">${date}</p>
                <p class="moiEvent">${mois}</p>
              </div>
              <div class="traitEvent"><div class="flexible-line"></div></div>
              <div>
                <p class="infosEvent">
                  <span class="titreEvent">${titre}</span><br />
                  <span class="horaireEvent">${heureDebut} - ${heureFin}</span>
                </p>
              </div>
              <div class="traitEvent traiFin"><div class="flexible-line"></div></div>
              <div>
                <a class="plusInfos" href="${url}" target="_blank" rel="noopener">
                  <span class="plusplus">+</span> d'infos
                </a>
              </div>
            </div>`;
        }).join("");

        list.hidden = false;
      })
      .catch(() => {
        loading.hidden = true;
        empty.hidden = false;
      });
  });
</script>

<style is:global>
  .loading-indicator {
    text-align: center;
    padding: 2rem;
    color: var(--dark-text-color);
  }

  .no-events {
    text-align: center;
    padding: 2rem;
    color: var(--grey-text-color);
    font-style: italic;
  }

  .derniersEvenementsGridAll {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-block: 60px;
    max-width: 60rem;
    margin-inline: auto;
    font-size: 1.1rem;
  }
  
  @media screen and (max-width: 600px) {
    .derniersEvenementsGridAll {
      font-size: 1rem;
      margin-inline: 2%;
    }
  }

  .derniersEvenementsGrid1 {
    display: grid;
    grid-template-columns: 1fr 1fr 2fr 3fr 2fr 1fr;
    align-items: center;
    border: 2px solid var(--borderColor);
    padding-inline: 1rem;
    padding-block: 1.3rem;
    border-radius: 20px;
    box-shadow: 2px 3px 5px 2px rgba(0, 0, 0, 0.1);
  }
  
  @media screen and (max-width: 600px) {
    .derniersEvenementsGrid1 {
      grid-template-columns: 1fr 1fr 1fr 1fr;
      padding-inline: 0.5rem;
    }
  }

  .imgEvent {
    width: 7rem;
    height: 7rem;
    border: 3px solid var(--background-color);
    border-radius: 8px;
    object-fit: cover;
    transition: border-color 0.4s ease;
  }
  
  .imgEvent:hover {
    border: 3px solid var(--primary-color);
  }

  .dateEvent {
    text-align: center;
  }
  
  .jourLEvent {
    font-size: 0.9em;
  }
  
  .jourNEvent {
    font-size: 60px;
    color: var(--secondary-color);
    font-weight: 600;
  }
  
  .moiEvent {
    font-size: 1.2em;
  }

  .flexible-line {
    width: 100%;
    height: 2px;
    background-color: var(--gold-shadow-color);
  }

  .infosEvent {
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  .titreEvent {
    font-weight: bold;
  }
  
  @media screen and (max-width: 600px) {
    .titreEvent {
      white-space: wrap;
    }
    .traiFin {
      display: none;
    }
  }

  .horaireEvent {
    text-align: center;
  }

  .plusInfos {
    font: bold normal normal 1.1em/20px Muli;
    color: var(--secondary-color);
    border-bottom: 2px solid var(--secondary-color);
    white-space: nowrap;
    margin-left: 1rem;
    transition: border-color 0.3s ease;
  }

  .plusInfos:hover {
    border-bottom: 2px solid #e6c535e3;
  }
  
  .plusInfos:hover .plusplus {
    color: #e6c535e3;
  }
  
  .plusplus {
    font-size: 1.5em;
    transition: color 0.3s ease;
  }
</style>