<!-- déclaration d'un tableau d'événements-->
<section
  x-data="{ events: [], showAll: window.location.pathname.includes('agenda') }"
  x-init="
    fetch('../events.json')
      .then(response => response.json())
      .then(data => {
        const today = new Date();
        events = data
          .filter(event => new Date(event.startDate) > today)
          .sort((a, b) => new Date(a.startDate) - new Date(b.startDate));

        if (!showAll) {
          events = events.slice(0, 3);
        }
      })
  "
>

  <div class="derniersEvenementsGridAll">
    <template x-for="event in events" :key="event.title">
      <div class="derniersEvenementsGrid1">
        <!-- Bannière de l'événement -->
        <a :href="event.url" target="_blank">
          <img class="imgEvent" :src="event.logoUrl" :alt="event.title"/>
        </a>
        <!-- Détails de la date -->
        <div class="dateEvent">
          <p
            class="jourLEvent"
            x-text="new Date(event.startDate).toLocaleDateString('fr-FR', { weekday: 'long' })"
          >
          </p>
          <p class="jourNEvent" x-text="new Date(event.startDate).getDate()">
          </p>
          <p
            class="moiEvent"
            x-text="new Date(event.startDate).toLocaleDateString('fr-FR', { month: 'long' })"
          >
          </p>
        </div>

        <div class="traitEvent">
          <div class="flexible-line"></div>
        </div>

        <!-- Titre et horaires -->
        <div>
          <p id="infosEvent">
            <span class="titreEvent" x-text="event.title"></span>
            <br />
            <span
              class="horaireEvent"
              x-text="`${new Date(event.startDate).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })} ${new Date(event.endDate).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}`"
            ></span>
          </p>
        </div>
        <div id="traiFin" class="traitEvent">
          <div class="flexible-line"></div>
        </div>

        <!-- Lien vers plus d'infos -->
        <div>
          <a class="plusInfos" :href="event.url" target="_blank">
            <span class="plusplus">+</span> d'infos
          </a>
        </div>
      </div>
    </template>
  </div>
</section>

<style>
  .derniersEvenementsGridAll {
    display: flex;
    flex-direction: column;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
    margin-block: 60px;
    max-width: 60rem;
    margin-inline: 2%;
    margin-inline: auto;
    font-size: 1.1rem;
  }
  @media screen and (max-width: 600px) {
    .derniersEvenementsGridAll {
      font-size: 1rem;
    }
  }

  .derniersEvenementsGrid1 {
    display: grid;
    grid-template-columns: 1fr 1fr 2fr 3fr 2fr 1fr;
    align-items: center;
    border: 2px solid var(--borderColor);
    padding-inline: 1rem;
    padding-block: 1.3rem;
    border-radius: 20px;
    box-shadow: 2px 3px 5px 2px rgba(0, 0, 0, 0.1);
  }
  @media screen and (max-width: 600px) {
    .derniersEvenementsGrid1 {
      grid-template-columns: 1fr 1fr 1fr 1fr;
      padding-inline: 0.5rem;
    }
  }

  .cadreImgEvent {
    
  }
  .imgEvent {
    width: 7rem;
    height: 7rem;
    overflow: hidden;
    border: 3px solid var(--background-color);
    border-radius: 8px;
    object-fit: cover;
    transition: border-color 0.4s ease;
  }
  .imgEvent:hover {
    border: 3px solid var(--primary-color);
  }

  .dateEvent {
    text-align: center;
  }
  .jourLEvent {
    font-size: 0.9em;
  }
  .jourNEvent {
    font-size: 60px;
    color: var(--secondary-color);
    font-weight: 600;
  }
  .moiEvent {
    font-size: 1.2em;
  }

  .flexible-line {
    width: 100%;
    height: 2px;
    background-color: var(--gold-shadow-color);
    
  }

  #infosEvent {
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  .titreEvent {
    font-weight: bold;
  }
  @media screen and (max-width: 600px) {
    .titreEvent {
      white-space: wrap;
    }
    #traiFin {
      display: none;
    }
  }

  .horaireEvent {
    text-align: center;
  }

  .plusInfos {
    font: bold normal normal 1.1em/20px Muli;
    color: var(--secondary-color);
    border-bottom: 2px solid var(--secondary-color);
    white-space: nowrap;
    margin-left: 1rem;
    transition: border-color 0.3s ease;
  }

  .plusInfos:hover {
    border-bottom: 2px solid #e6c535e3;
    .plusplus {
      color: #e6c535e3;
    }
  }
  .plusplus {
    font-size: 1.5em;
    transition: color 0.3s ease;
  }
  .plusplus:hover {
    color: #f1d13fe3;
  }
</style>
