---
// src/components/catalogue-footer.astro

// Importation des images
import bricolageIcon from '../assets/img/boite-a-outils.webp';
import multimediaIcon from '../assets/img/smart-tv.webp';
import jardinageIcon from '../assets/img/jardinage.png';
import cuisineIcon from '../assets/img/fouet.png';
import mobiliteIcon from '../assets/img/velo-de-montagne.webp';
import nettoyageIcon from '../assets/img/produits-de-nettoyage.webp';
import loisirsIcon from '../assets/img/balle.webp';
import evenementIcon from '../assets/img/ballons.png';
import maisonIcon from '../assets/img/maison.png';
import campingIcon from '../assets/img/tente-de-camping.webp';
import electroniqueIcon from '../assets/img/tour-pc.webp';
import santeIcon from '../assets/img/soins-de-sante.webp';
import artsIcon from '../assets/img/outils-de-couture.png';
import sportIcon from '../assets/img/physique.webp';

// Structure des catégories pour faciliter la maintenance
const categories = [
  {
    href: "https://objethequecornouaille.myturn.com/library/inventory/browse?category_hierarchy=0%2FBricolage%2FOutillage%7C13484",
    icon: bricolageIcon,
    alt: "Icône d'outils de bricolage",
    label: "Bricolage"
  },
  {
    href: "https://objethequecornouaille.myturn.com/library/inventory/browse?category_hierarchy=0%2FMultim%C3%A9dia%7C13492",
    icon: multimediaIcon,
    alt: "Icône de télévision connectée",
    label: "Multimedia"
  },
  {
    href: "https://objethequecornouaille.myturn.com/library/inventory/browse?category_hierarchy=0%2FJardinage%7C13489",
    icon: jardinageIcon,
    alt: "Icône d'outils de jardinage",
    label: "Jardinage"
  },
  {
    href: "https://objethequecornouaille.myturn.com/library/inventory/browse?type_hierarchy=0%2FKitchen+%26+Dining%7C180",
    icon: cuisineIcon,
    alt: "Icône d'ustensile de cuisine",
    label: "Cuisine"
  },
  {
    href: "https://objethequecornouaille.myturn.com/library/inventory/browse?category_hierarchy=0%2FMobilit%C3%A9%7C13491",
    icon: mobiliteIcon,
    alt: "Icône de vélo de montagne",
    label: "Mobilité"
  },
  {
    href: "https://objethequecornouaille.myturn.com/library/inventory/browse?category_hierarchy=0%2FEntretien+%26+Nettoyage%7C13488",
    icon: nettoyageIcon,
    alt: "Icône de produits de nettoyage",
    label: "Nettoyage"
  },
  {
    href: "https://objethequecornouaille.myturn.com/library/inventory/browse?category_hierarchy=0%2FLoisirs+%26+Jeux%7C13490",
    icon: loisirsIcon,
    alt: "Icône de jouet",
    label: "Loisirs et Jeux"
  },
  {
    href: "https://objethequecornouaille.myturn.com/library/inventory/browse?category_hierarchy=0%2FF%C3%AAte%7C13798",
    icon: evenementIcon,
    alt: "Icône de ballons de fête",
    label: "Evénement"
  },
  {
    href: "https://objethequecornouaille.myturn.com/library/inventory/browse?category_hierarchy=0%2FMaison%7C14602",
    icon: maisonIcon,
    alt: "Icône de maison",
    label: "Maison"
  },
  {
    href: "https://objethequecornouaille.myturn.com/library/inventory/browse?category_hierarchy=1%2FSports+%26+Plein+air%7C13487%2FCamping%7C13507",
    icon: campingIcon,
    alt: "Icône de tente de camping",
    label: "Camping"
  },
  {
    href: "https://objethequecornouaille.myturn.com/library/inventory/browse?category_hierarchy=0%2FElectronique%7C13706",
    icon: electroniqueIcon,
    alt: "Icône d'ordinateur",
    label: "Électronique"
  },
  {
    href: "https://objethequecornouaille.myturn.com/library/inventory/browse?type_hierarchy=0%2FMedical+Equipment%7C518",
    icon: santeIcon,
    alt: "Icône de santé",
    label: "Santé"
  },
  {
    href: "https://objethequecornouaille.myturn.com/library/inventory/browse?category_hierarchy=0%2FArts+cr%C3%A9atifs%7C13477",
    icon: artsIcon,
    alt: "Icône de matériel de couture",
    label: "Arts créatifs"
  },
  {
    href: "https://objethequecornouaille.myturn.com/library/inventory/browse?category_hierarchy=0%2FSports+%26+Plein+air%7C13487",
    icon: sportIcon,
    alt: "Icône de sport",
    label: "Sport et Plein air"
  }
];
---

<section id="cadreRaccourcisCatalogue" transition:persist>
  <h2>
    Catégories d'objets :
    <p class="sousTexteH2">Rummadoù traoù :</p>
  </h2>
  <div class="grille-categories">
    {categories.map(category => (
      <a href={category.href} class="categorie-item">
        <img 
          src={category.icon.src} 
          alt={category.alt} 
          class="icone-categorie" 
          width="48" 
          height="48"
        />
        <span>{category.label}</span>
      </a>
    ))}
  </div>
</section>

<style>
  #cadreRaccourcisCatalogue {
    padding-block: 2rem;
    background-color: var(--grey-background);
  }

  h2 {
    margin-bottom: 1.5rem;
  }

  .sousTexteH2 {
    font-size: 1.2rem;
    margin-top: 0.25rem;
  }

  .grille-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    justify-content: center;
    max-width: 80rem;
    margin-inline: auto;
  }

  .categorie-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem 0.5rem;
    border-radius: 8px;
    transition: background-color 0.3s ease;
    width: 150px; /* Largeur fixe correspondant au minmax de votre grid */
  }

  .categorie-item:hover {
    background-color: var(--FAQcolor);
  }

  .icone-categorie {
    width: 48px;
    height: 48px;
    margin-bottom: 0.75rem;
  }

  .categorie-item span {
    color: var(--dark-text-color);
    font-weight: 500;
    text-align: center;
  }
</style>