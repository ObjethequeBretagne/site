<div class="compteurs moon">
  <div>
    <div class="counter" data-end-value="538">538</div>
    <p class="valeurCounter">Objets stockés</p>
  </div>
  <div>
    <img
      class="etoilesCompteur star"
      src="assets/svg/etoiles.svg"
      alt="étoiles près du compteur"
    />
    <div class="counter" data-end-value="2075">2075</div>
    <p class="valeurCounter">Emprunts terminés</p>
  </div>
  <div>
    <div class="counter" data-end-value="160">160</div>
    <p class="valeurCounter">Adhérents</p>
  </div>
  <style>
    .compteurs {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-block: 60px;
      padding-inline: 10%;
      font-size: max(8vw, 42px);
      font-weight: 600;
      text-align: center;
      color: var(--dark-text-color);
    }
    .valeurCounter {
      font-size: 0.24em;
      color: var(--secondary-color);
    }
    .etoilesCompteur {
      transform: translateY(-0.28em) translateX(1em);
      height: max(0.8em, 3vw);
      float: right;
    }
    @media screen and (max-width: 400px) {
      .compteurs {
        padding-inline: 7%;
      }
    }
  </style>
  <script>
    document.addEventListener("astro:page-load", () => {
      // Constantes
      const ANIMATION_DURATION = 2000;

      // Fonction d'animation (progression linéaire)
      function animateCounter(
        element: HTMLElement,
        endValue: number,
        duration: number
      ) {
        const startTime = performance.now();

        function updateCounter(currentTime: number) {
          const elapsedTime = currentTime - startTime;
          const progress = Math.min(elapsedTime / duration, 1); // Progression linéaire
          const currentValue = Math.floor(progress * endValue);
          element.textContent = currentValue.toString();

          if (progress < 1) {
            requestAnimationFrame(updateCounter);
          }
        }

        requestAnimationFrame(updateCounter);
      }

      // Intersection Observer pour démarrer l'animation quand visible
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const element = entry.target as HTMLElement;
            const endValue = parseInt(element.dataset.endValue || "0", 10); // Récupère la valeur de l'attribut data-end-value

            if (!element.classList.contains("animated")) {
              element.classList.add("animated");
              animateCounter(element, endValue, ANIMATION_DURATION);
            }

            observer.unobserve(entry.target);
          }
        });
      });

      // Sélectionne tous les compteurs
      document.querySelectorAll(".counter").forEach((counter) => {
        observer.observe(counter);
      });
    });
  </script>
</div>
