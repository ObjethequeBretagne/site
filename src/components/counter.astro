<div class="compteurs moon">
  <div>
    <div class="counter"></div>
    <p class="valeurCounter">Objets stockés</p>
  </div>
  <div>
    <img
      class="etoilesCompteur star"
      src="assets/svg/etoiles.svg"
      alt="étoiles près du compteur"
    />
    <div class="counter1"></div>
    <p class="valeurCounter">Emprunts terminés</p>
  </div>
  <div>
    <div class="counter2"></div>
    <p class="valeurCounter">Adhérents cumulés</p>
  </div>
  <style>
    .compteurs {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-block: 60px;
      padding-inline: 10%;
      font-size: max(8vw, 42px);
      font-weight: 600;
      text-align: center;
      color: var(--dark-text-color);
    }
    .valeurCounter {
      font-size: 0.24em;
      color: var(--secondary-color);
    }
    .etoilesCompteur {
      transform: translateY(-0.28em) translateX(1em);
      height: max(0.8em, 3vw);
      float: right;
    }
    @media screen and (max-width: 400px) {
      .compteurs {
        padding-inline: 7%;
      }
    }
  </style>
  <script>
    document.addEventListener("astro:page-load", () => {
      function animateCounter(
        element: HTMLElement, // Déclare que 'element' est un élément HTML
        endValue: number, // 'endValue' est un nombre
        duration: number // 'duration' est un nombre
      ) {
        let startValue = 0;
        const startTime = performance.now();

        function updateCounter(currentTime: number) { // 'currentTime' est un nombre
          const elapsedTime = currentTime - startTime;
          const progress = Math.min(elapsedTime / duration, 1);
          const currentValue = Math.floor(progress * endValue);
          element.textContent = currentValue.toString();

          if (progress < 1) {
            requestAnimationFrame(updateCounter);
          }
        }

        requestAnimationFrame(updateCounter);
      }

      const counters = [
        { selector: ".counter", endValue: 535 },
        { selector: ".counter1", endValue: 1677 },
        { selector: ".counter2", endValue: 443 },
      ];

      counters.forEach(({ selector, endValue }) => {
        const element = document.querySelector(selector) as HTMLElement; // Assure que c'est un HTMLElement
        if (element) {
          animateCounter(element, endValue, 2000); // Durée de 2000 ms
        }
      });
    });
  </script>
</div>
