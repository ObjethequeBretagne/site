---
---

<section id="espace-bricolage-section">
  <h2>Réserver un créneau espace bricolage</h2>
  <div id="eb-loading" class="loading-indicator">
    <p>Chargement des créneaux...</p>
  </div>
  <div id="eb-empty" class="no-events" hidden>
    <p>Aucun créneau disponible pour le moment.</p>
  </div>
  <div id="eb-list" class="derniersEvenementsGridAll" hidden></div>
</section>

<script>
  function escHtml(str: string) {
    return str.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
  }

  document.addEventListener("astro:page-load", () => {
    const loading = document.getElementById("eb-loading")!;
    const empty   = document.getElementById("eb-empty")!;
    const list    = document.getElementById("eb-list")!;

    fetch("/events.json")
      .then(r => r.json())
      .then((data: any[]) => {
        const today     = new Date();
        const twoMonths = new Date(today);
        twoMonths.setMonth(twoMonths.getMonth() + 2);
        const fr  = "fr-FR";
        const fmt = { hour: "2-digit" as const, minute: "2-digit" as const };

        const events = data
          .filter(e => {
            const start = new Date(e.startDate);
            return e.title?.toLowerCase().startsWith("espace bricolage") && start > today && start <= twoMonths;
          })
          .sort((a, b) => +new Date(a.startDate) - +new Date(b.startDate));

        loading.hidden = true;

        if (events.length === 0) {
          empty.hidden = false;
          return;
        }

        list.innerHTML = events.map(event => {
          const start      = new Date(event.startDate);
          const end        = new Date(event.endDate);
          const jour       = start.toLocaleDateString(fr, { weekday: "long" });
          const date       = start.getDate();
          const mois       = start.toLocaleDateString(fr, { month: "long" });
          const heureDebut = start.toLocaleTimeString(fr, fmt);
          const heureFin   = end.toLocaleTimeString(fr, fmt);
          const url        = escHtml(event.url ?? "#");
          const logo       = escHtml(event.logoUrl ?? "");
          const titre      = escHtml(event.title ?? "");
          const isVendredi = start.getDay() === 5;

          return `
            <div class="derniersEvenementsGrid1">
              <a href="${url}" target="_blank" rel="noopener">
                <img class="imgEvent" src="${logo}" alt="${titre}" loading="lazy" />
              </a>
              <div class="dateEvent">
                <p class="jourLEvent">${jour}</p>
                <p class="jourNEvent">${date}</p>
                <p class="moiEvent">${mois}</p>
              </div>
              <div class="traitEvent"><div class="flexible-line"></div></div>
              <div class="eb-infos">
                <span class="eb-badge ${isVendredi ? "eb-vendredi" : "eb-samedi"}">${jour}</span>
                <span class="eb-horaires">${heureDebut} – ${heureFin}</span>
              </div>
              <div class="traitEvent traiFin"><div class="flexible-line"></div></div>
              <div>
                <a class="plusInfos" href="${url}" target="_blank" rel="noopener">
                  <span class="plusplus">+</span> réserver
                </a>
              </div>
            </div>`;
        }).join("");

        list.hidden = false;
      })
      .catch(() => {
        loading.hidden = true;
        empty.hidden = false;
      });
  });
</script>

<style is:global>
  #espace-bricolage-section h2 {
    font-size: clamp(1.2rem, 2vw + 0.5rem, 1.8rem);
    color: var(--secondary-color);
    margin-block: 2rem;
    text-align: center;
  }

  .eb-badge {
    display: inline-block;
    padding: 0.3rem 1rem;
    border-radius: 20px;
    font-size: 0.95em;
    font-weight: 700;
    text-transform: capitalize;
  }

  .eb-vendredi {
    background: var(--primary-color);
    color: var(--light-text-color);
  }

  .eb-samedi {
    background: var(--secondary-color);
    color: var(--light-text-color);
  }

  .eb-infos {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
  }

  .eb-horaires {
    color: var(--grey-text-color);
    white-space: nowrap;
  }
</style>
