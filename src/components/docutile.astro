---
interface Props {
  title: string;
  href: string;
}
const { title, href } = Astro.props;
---

<div class="docUtile">
  <h3>{title}</h3>
  <a class="telecharger" target="_blank" href={href}>
    <p>télécharger&nbsp;<img class="pdfImg" src="/assets/img/pdf-logo.png" alt="PDF" loading="lazy" /></p>
  </a>
</div>

<style>
  .docUtile {
    position: relative;
    background-color: var(--grey-background);
    width: 18rem;
    height: 7.7rem;
    border-radius: 20px;
  }
  .docUtile h3 {
    font-size: 1.1rem;
    margin-block: calc(var(--marginBlock) / 4);
  }

  .telecharger {
    transform: translate(1.5em, 1em);
    position: absolute;
    bottom: 0;
    right: 0;
    display: flex;
    justify-content: flex-end;
    margin-block: calc(var(--marginBlock) / 2);
    margin-right: 8%;
  }

  .telecharger p {
    font-size: 0.8rem;
    color: var(--grey-text-color);
    position: relative;
  }
  .telecharger p:after {
    content: "";
    position: absolute;
    width: 100%;
    height: 2px;
    background-color: var(--secondary-color);
    left: 0;
    bottom: -2px;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.2s ease;
  }
  .telecharger p:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .pdfImg {
    height: 2.3rem;
  }
</style>
