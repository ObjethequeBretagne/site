---
import partenaires from "../data/partenaires.json";

// Deux bandeaux qui défilent en sens inverse : institutionnels puis privés, dans
// l'ordre de partenaires.json (édité depuis /admin/partenaires).
const institutionnels = partenaires.filter((p) => p.categorie === "institutionnel");
const prives = partenaires.filter((p) => p.categorie === "privé");
---

{institutionnels.length > 0 && (
  <section class="infiniteScroller moon" style={`--_nombrePartenaires: ${institutionnels.length}`}>
    {institutionnels.map((p, i) => (
      <div class="star partenaires" style={`--n:${i + 1}`}>
        <a href={p.href} target="_blank"><img alt={`logo/lien vers ${p.nom}`} src={p.logo} /></a>
      </div>
    ))}
  </section>
)}
{prives.length > 0 && (
  <section class="infiniteScroller moon" style={`--_nombrePartenairesPrive: ${prives.length}`}>
    {prives.map((p, i) => (
      <div class="star partenaires partenairesR" style={`--n:${i + 1}`}>
        <a href={p.href} target="_blank"><img alt={`logo/lien vers ${p.nom}`} src={p.logo} /></a>
      </div>
    ))}
  </section>
)}
<style>
  .infiniteScroller {
    --_dureeAnimationPartenaires: 50s;
    --_dimensionInfiniteScroller: 200px;
    max-width: 1536px;
    width: 100%;
    overflow: hidden;
    margin-inline: auto;
    margin-block: var(--marginBlock);
    height: var(--_dimensionInfiniteScroller);
    mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0),
      rgba(0, 0, 0, 1) 20%,
      rgba(0, 0, 0, 1) 80%,
      rgba(0, 0, 0, 0)
    );
  }
  .partenaires {
    width: var(--_dimensionInfiniteScroller);
    height: var(--_dimensionInfiniteScroller);
    z-index: 1;
    left: max(
      calc(var(--_dimensionInfiniteScroller) * var(--_nombrePartenaires)),
      100%
    );
    animation-name: scrollleft;
    animation-duration: var(--_dureeAnimationPartenaires);
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-delay: calc(
      var(--_dureeAnimationPartenaires) / var(--_nombrePartenaires) *
        (var(--_nombrePartenaires) - var(--n)) * -1
    );
  }
  .partenairesR {
    right: max(
      calc(var(--_dimensionInfiniteScroller) * var(--_nombrePartenairesPrive)),
      100%
    );
    left: auto;
    animation-name: scrollright;
    animation-delay: calc(
      var(--_dureeAnimationPartenaires) / var(--_nombrePartenairesPrive) *
        (var(--_nombrePartenairesPrive) - var(--n)) * -1
    );
  }
  .partenaires > a > img {
    inline-size: 100%;
    aspect-ratio: 1/1;
    object-fit: contain;
  }

  @keyframes scrollleft {
    to {
      left: calc(var(--_dimensionInfiniteScroller) * -1);
    }
  }
  @keyframes scrollright {
    to {
      right: calc(var(--_dimensionInfiniteScroller) * -1);
    }
  }
</style>
