---
// Agenda de réservation de créneaux.
// Affiche les événements HelloAsso dont le titre commence par `prefixe`
// (espace bricolage, couture accompagnée, couture autonomie, etc.).
interface Props {
  titre: string;
  /** Début du titre HelloAsso ; la suite du titre est libre (date, mention). */
  prefixe: string;
  id: string;
  /** Nombre de mois affichés à partir d'aujourd'hui */
  mois?: number;
  /** Jour de la semaine mis en avant en orange (0 = dimanche ... 6 = samedi) */
  jourAccent?: number;
  texteBouton?: string;
}

const {
  titre,
  prefixe,
  id,
  mois = 2,
  jourAccent,
  texteBouton = "réserver",
} = Astro.props;
---

<section
  class="creneaux-section"
  id={id}
  data-prefixe={prefixe}
  data-mois={mois}
  data-jour-accent={jourAccent ?? ""}
  data-bouton={texteBouton}
>
  <h2>{titre}</h2>
  <div class="loading-indicator" data-role="loading">
    <p>Chargement des créneaux...</p>
  </div>
  <div class="no-events" data-role="empty" hidden>
    <p>Aucun créneau n’est actuellement ouvert à la réservation.</p>
    <p>De nouvelles dates seront proposées prochainement.</p>
  </div>
  <div class="creneaux-liste" data-role="list" hidden></div>
</section>

<script>
  import { commencePar } from "../lib/evenements";

  function escHtml(str: string) {
    return str.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
  }

  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll<HTMLElement>(".creneaux-section");
    if (sections.length === 0) return;

    sections.forEach(section => {
      const loading = section.querySelector<HTMLElement>('[data-role="loading"]')!;
      const empty   = section.querySelector<HTMLElement>('[data-role="empty"]')!;
      const list    = section.querySelector<HTMLElement>('[data-role="list"]')!;

      const prefixe    = section.dataset.prefixe ?? "";
      const nbMois     = Number(section.dataset.mois ?? 2);
      const jourAccent = section.dataset.jourAccent ? Number(section.dataset.jourAccent) : null;
      const boutonBrut = section.dataset.bouton ?? "réserver";
      const bouton     = escHtml(boutonBrut);

      fetch("/events.json")
        .then(r => r.json())
        .then((data: any[]) => {
          const today  = new Date();
          const limite = new Date(today);
          limite.setMonth(limite.getMonth() + nbMois);
          const fr  = "fr-FR";
          const fmt = { hour: "2-digit" as const, minute: "2-digit" as const };

          const events = data
            .filter(e => {
              const start = new Date(e.startDate);
              return commencePar(e.title ?? "", prefixe) && start > today && start <= limite;
            })
            .sort((a, b) => +new Date(a.startDate) - +new Date(b.startDate));

          loading.hidden = true;

          if (events.length === 0) {
            empty.hidden = false;
            return;
          }

          list.innerHTML = events.map(event => {
            const start      = new Date(event.startDate);
            const end        = new Date(event.endDate);
            const jour       = start.toLocaleDateString(fr, { weekday: "long" });
            const date       = start.getDate();
            const moisLabel  = start.toLocaleDateString(fr, { month: "long" });
            const heureDebut = start.toLocaleTimeString(fr, fmt);
            const heureFin   = end.toLocaleTimeString(fr, fmt);
            const url        = escHtml(event.url ?? "#");
            const accent     = jourAccent !== null && start.getDay() === jourAccent;
            const libelle    = escHtml(`${boutonBrut} : ${jour} ${date} ${moisLabel}, de ${heureDebut} à ${heureFin}`);

            return `
              <a class="creneau-carte${accent ? " creneau-carte--accent" : ""}"
                 href="${url}" target="_blank" rel="noopener" aria-label="${libelle}">
                <span class="creneau-jour">${jour}</span>
                <span class="creneau-date">${date}</span>
                <span class="creneau-mois">${moisLabel}</span>
                <span class="creneau-horaires">${heureDebut} – ${heureFin}</span>
                <span class="creneau-action">${bouton}</span>
              </a>`;
          }).join("");

          list.hidden = false;
        })
        .catch(() => {
          loading.hidden = true;
          empty.hidden = false;
        });
    });
  });
</script>

<style is:global>
  .creneaux-section h2 {
    font-size: clamp(1.2rem, 2vw + 0.5rem, 1.8rem);
    color: var(--secondary-color);
    margin-inline: 0;
    margin-top: 4rem;
    margin-bottom: 2rem;
    text-align: center;
  }

  /* Une pastille par créneau, sur une seule rangée. Elle occupe toute la
     largeur disponible et ne défile que si les cartes ne tiennent pas : le
     padding reste minimal pour ne pas déclencher un défilement inutile, il
     sert juste à ne pas rogner l'ombre des cartes. */
  .creneaux-liste {
    display: flex;
    justify-content: safe center;
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding-inline: 1rem;
    padding-block: 0.6rem;
    margin-bottom: 60px;
    scrollbar-width: thin;
  }

  .creneau-carte {
    flex: 0 0 10rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    padding: 1.1rem 0.75rem 1rem;
    border: 2px solid var(--grey-background);
    border-radius: 16px;
    background: var(--background-color);
    box-shadow: 2px 3px 5px 2px rgba(0, 0, 0, 0.08);
    color: var(--dark-text-color);
    text-align: center;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .creneau-carte:hover,
  .creneau-carte:focus-visible {
    transform: translateY(-3px);
    border-color: var(--secondary-color);
  }

  .creneau-carte--accent:hover,
  .creneau-carte--accent:focus-visible {
    border-color: var(--primary-color);
  }

  .creneau-jour {
    font-size: 0.95rem;
    text-transform: capitalize;
    color: var(--grey-text-color);
  }

  .creneau-date {
    font-size: 2.8rem;
    line-height: 1.1;
    font-weight: 600;
    color: var(--secondary-color);
  }

  .creneau-carte--accent .creneau-date {
    color: var(--primary-color);
  }

  .creneau-mois {
    font-size: 1.05rem;
  }

  .creneau-horaires {
    margin-top: 0.2rem;
    font-size: 0.95rem;
    color: var(--grey-text-color);
    white-space: nowrap;
  }

  .creneau-action {
    margin-top: 0.8rem;
    padding: 0.35rem 1.1rem;
    border-radius: 20px;
    background: var(--secondary-color);
    color: var(--light-text-color);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: capitalize;
    white-space: nowrap;
  }

  .creneau-carte--accent .creneau-action {
    background: var(--primary-color);
  }
</style>
