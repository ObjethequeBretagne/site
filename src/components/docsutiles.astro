---
import DocUtile from "./docutile.astro";
import documents from "../data/documents.json";
---

<section>
  <div id="DocsUtiles">
    {documents.map((doc) => <DocUtile title={doc.title} href={doc.href} />)}
  </div>
</section>
<style>
  #DocsUtiles {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-inline: auto;
    margin-block: var(--marginBlock);
    max-width: 80rem;
  }
</style>
